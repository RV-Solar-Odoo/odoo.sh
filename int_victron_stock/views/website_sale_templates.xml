<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_hide_cart_when_unavailable" inherit_id="website_sale.cta_wrapper"
              name="Hide cart when nothing to ship">
        <!-- d-none wins over d-flex in Bootstrap, so the button is gone on first paint.
             A later variant change removes d-none when either side has stock. -->
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="attributes">
            <attribute name="t-att-class"
                       add="(' d-none out_of_stock' if product and not product._int_can_order_online(product_variant) else '')"
                       separator=" + "/>
        </xpath>
    </template>

    <template id="product_shipping_badge" inherit_id="website_sale.product" name="Shipping Availability">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="after">
            <t t-set="int_variant" t-value="product.env['product.product'].browse(combination_info.get('product_id'))"/>
            <t t-set="int_lines" t-value="product._int_availability_lines(int_variant)"/>
            <div t-if="int_lines and not combination_info.get('show_click_and_collect_availability')" class="o_int_shipping_badge mb-4">
                <t t-foreach="int_lines" t-as="int_line">
                    <div class="mb-1">
                        <span t-attf-class="badge #{int_line['css']}">
                            <i t-attf-class="fa #{int_line['icon']} me-1" role="presentation"/>
                            <t t-out="int_line['label']"/>
                        </span>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <template id="product_click_and_collect_props" inherit_id="website_sale_collect.product_page_click_and_collect"
              name="Warehouse and Victron in the stock box">
        <xpath expr="//owl-component[@name='website_sale_collect.ClickAndCollectAvailability']" position="attributes">
            <attribute name="t-att-props">json.dumps({
                'productId': product_variant.id,
                'zipCode': zip_code,
                'showSelectStoreButton': show_select_store_button,
                'selectedLocationData': selected_location_data or {},
                'inStoreStockData': combination_info.get('in_store_stock_data', {}),
                'deliveryStockData': combination_info.get('delivery_stock_data', {}),
                'availabilityLines': product._int_availability_lines(product_variant),
            })</attribute>
        </xpath>
    </template>

    <template id="products_item_shipping_badge" inherit_id="website_sale.products_item"
              name="Shipping Availability (grid)" active="True">
        <xpath expr="//div[hasclass('o_wsale_product_information_text')]" position="inside">
            <t t-set="int_lines" t-value="product._int_availability_lines()"/>
            <div t-if="int_lines" class="o_int_card_availability">
                <span class="o_int_card_availability_label">Availability:</span>
                <div class="o_int_card_availability_lines">
                    <t t-foreach="int_lines" t-as="int_line">
                        <div t-attf-class="#{'text-success' if int_line['status'] == 'immediate' else 'text-muted'}"
                             t-out="int_line['label']"/>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Shop filter, in the markup of a tag group section. It stays outside form.js_attributes:
         the stock script reloads on any change in there and only reads tags and attributes. -->
    <template id="shop_hide_out_of_stock" name="Hide Out of Stock Filter">
        <t t-if="isMobile">
            <div>
                <h2 class="accordion-header mb-0" id="o_wsale_offcanvas_int_availability_header">
                    <button class="o_wsale_offcanvas_title accordion-button border-top rounded-0"
                            type="button"
                            t-att-data-status="int_hide_out_of_stock and 'active' or 'inactive'"
                            data-bs-toggle="collapse"
                            data-bs-target="#o_wsale_offcanvas_int_availability"
                            aria-expanded="true"
                            aria-controls="o_wsale_offcanvas_int_availability">
                        <b>Availability</b>
                    </button>
                </h2>
                <div id="o_wsale_offcanvas_int_availability"
                     class="accordion-collapse collapse show"
                     aria-labelledby="o_wsale_offcanvas_int_availability_header">
                    <div class="accordion-body pt-0">
                        <div class="list-group list-group-flush">
                            <t t-call="int_victron_stock.shop_hide_out_of_stock_input">
                                <t t-set="int_input_id" t-valuef="int_hide_out_of_stock_mobile"/>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
        <t t-else="">
            <div class="accordion-item">
                <div class="accordion-header h6 mb-0">
                    <button class="accordion-button px-0 bg-transparent shadow-none"
                            type="button"
                            data-bs-toggle="collapse"
                            aria-expanded="true"
                            data-bs-target="#o_wsale_int_availability_inner"
                            aria-controls="o_wsale_int_availability_inner">
                        <b>Availability</b>
                    </button>
                </div>
                <div id="o_wsale_int_availability_inner" class="accordion-collapse collapse show">
                    <div class="flex-column mb-3">
                        <t t-call="int_victron_stock.shop_hide_out_of_stock_input">
                            <t t-set="int_input_id" t-valuef="int_hide_out_of_stock_desktop"/>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="shop_hide_out_of_stock_input" name="Hide Out of Stock Checkbox">
        <div class="form-check mb-1">
            <input type="checkbox"
                   class="form-check-input o_int_hide_out_of_stock"
                   t-att-id="int_input_id"
                   t-att-checked="'checked' if int_hide_out_of_stock else None"
                   t-att-data-href="keep(hide_out_of_stock=0 if int_hide_out_of_stock else '1')"/>
            <label class="form-check-label fw-normal" t-att-for="int_input_id">Hide out of stock items</label>
        </div>
    </template>

    <template id="products_hide_out_of_stock" inherit_id="website_sale.products"
              name="Hide Out of Stock Filter (sidebar)">
        <xpath expr="//div[contains(@t-attf-class, 'products_attributes_filters')]" position="before">
            <t t-call="int_victron_stock.shop_hide_out_of_stock">
                <t t-set="isMobile" t-value="False"/>
            </t>
        </xpath>
    </template>

    <template id="offcanvas_hide_out_of_stock" inherit_id="website_sale.o_wsale_offcanvas"
              name="Hide Out of Stock Filter (mobile)">
        <xpath expr="//t[@t-call='website_sale.product_attribute_filters_form']" position="before">
            <t t-call="int_victron_stock.shop_hide_out_of_stock">
                <t t-set="isMobile" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="cart_line_victron" inherit_id="website_sale.cart_lines" name="Victron Cart Split">
        <xpath expr="//t[@t-call='website_sale.cart_line_description_following_lines']" position="after">
            <div t-if="line._int_victron_cart_note()" class="small text-muted mt-1" t-out="line._int_victron_cart_note()"/>
            <div t-if="line._int_victron_checkout_warning()" class="small text-danger mt-1" t-out="line._int_victron_checkout_warning()"/>
        </xpath>
    </template>

    <template id="checkout_ship_when" inherit_id="website_sale.checkout" name="When to Ship">
        <xpath expr="//div[@id='shop_checkout']/*[1]" position="before">
            <div t-if="order._int_victron_needs_ship_choice()" id="int_victron_ship_when" class="mb-4">
                <h5 class="mb-2">When to ship</h5>
                <p class="text-muted small">
                    Shipping is charged once, for the full order, including units that ship later.
                </p>
                <form action="/shop/victron_ship_when" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="policy" value="direct" id="int_victron_ship_direct"
                               onchange="this.form.submit()"
                               t-att-checked="'checked' if order.picking_policy != 'one' else None"/>
                        <label class="form-check-label" for="int_victron_ship_direct">
                            Ship what's in stock now, and the rest <t t-out="order.env['product.template']._int_lead_phrase()"/>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="policy" value="one" id="int_victron_ship_together"
                               onchange="this.form.submit()"
                               t-att-checked="'checked' if order.picking_policy == 'one' else None"/>
                        <label class="form-check-label" for="int_victron_ship_together">
                            Hold the order and ship everything together
                        </label>
                    </div>
                </form>
            </div>
        </xpath>
    </template>

    <template id="wishlist_hide_cart_when_unavailable" inherit_id="website_sale_wishlist.product_wishlist"
              name="Hide wishlist cart when nothing to ship">
        <xpath expr="//button[@id='add_to_cart_button']" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-elif">product._int_can_order_online(product_variant)</attribute>
        </xpath>
    </template>
</odoo>

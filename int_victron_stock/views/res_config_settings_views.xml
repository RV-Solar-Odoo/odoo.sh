<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_victron" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.int.victron</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Victron E-Order" name="int_victron_settings">
                    <setting string="Credentials" help="Log in to E-Order, open the API documentation at https://eorder.victronenergy.com/api/v1/, and paste the API token here. The username and password are only used when the token is empty.">
                        <field name="int_victron_token" password="True"/>
                        <field name="int_victron_username"/>
                        <field name="int_victron_password" password="True"/>
                    </setting>
                    <setting string="Feed" help="Adjust only if Victron changes the endpoint or the field names in their response.">
                        <field name="int_victron_endpoint"/>
                        <field name="int_victron_sku_field"/>
                        <field name="int_victron_qty_field"/>
                    </setting>
                    <setting string="Webshop lead time" help="Shown after the supplier quantity. Own warehouse stock is shown in full.">
                        <field name="int_victron_lead_time_label"/>
                    </setting>
                    <setting string="Purchasing" help="When a sale needs more than the warehouse has, a draft purchase order is created for this vendor and assigned to this buyer.">
                        <field name="int_victron_vendor_id"/>
                        <field name="int_victron_buyer_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="website_sale_collect.ClickAndCollectAvailability" t-inherit-mode="extension">
        <xpath expr="//div[@name='click_and_collect_availability']/h6" position="replace">
            <h6>
                <i class="fa fa-fw fa-map-marker text-muted"/>
                Main warehouse
            </h6>
        </xpath>
        <xpath expr="//div[@name='click_and_collect_availability']/div[hasclass('d-flex')]" position="replace">
            <div class="d-flex justify-content-between">
                <div t-if="this.warehouseLine" class="text-muted">
                    <i class="fa fa-fw fa-circle text-success"/>
                    <t t-out="this.warehouseLine.detail"/>
                </div>
                <div t-elif="this.supplierLine" class="text-muted">
                    <i class="fa fa-fw fa-circle text-muted"/>
                    Out of stock
                </div>
                <div t-else="" class="text-muted">
                    <i class="fa fa-fw fa-circle text-danger"/>
                    Out of stock
                </div>
                <a t-if="this.props.showSelectStoreButton" role="button" href="#">
                    <t t-if="this.state.selectedLocationData.id">Change store</t>
                    <t t-elif="this.state.inStoreStockData.in_stock">Select store</t>
                </a>
            </div>
        </xpath>
        <xpath expr="//div[@name='delivery_availability']" position="replace">
            <div name="delivery_availability" class="flex-row">
                <hr/>
                <h6>
                    <i class="fa fa-fw fa-truck text-muted"/>
                    Additional stock
                </h6>
                <div t-if="this.supplierLine" class="text-muted">
                    <i class="fa fa-fw fa-circle text-success"/>
                    <t t-out="this.supplierLine.detail"/>
                </div>
                <div t-elif="this.unavailableLine" class="text-muted">
                    <i class="fa fa-fw fa-circle text-danger"/>
                    <t t-out="this.unavailableLine.detail"/>
                </div>
                <div t-else="" class="text-muted">
                    <i class="fa fa-fw fa-circle text-muted"/>
                    None available
                </div>
            </div>
        </xpath>
    </t>

    <t t-inherit="website_sale_stock.product_availability" t-inherit-mode="extension">
        <xpath expr="//div[@id='out_of_stock_message']" position="replace"/>
    </t>
</templates>

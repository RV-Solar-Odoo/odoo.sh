<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form_tax_exemption" model="ir.ui.view">
        <field name="name">res.partner.form.tax.exemption</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <!-- Child contacts sync from their company, so an edit there would not stick. -->
            <xpath expr="//field[@name='property_account_position_id']" position="after">
                <field name="x_is_tax_exempt" readonly="parent_id and not is_company"/>
                <field name="x_tax_exemption_reason"
                       invisible="not x_is_tax_exempt"
                       readonly="parent_id and not is_company"/>
                <field name="x_tax_exemption_document_filename" invisible="1"/>
                <field name="x_tax_exemption_document"
                       filename="x_tax_exemption_document_filename"
                       invisible="not x_is_tax_exempt"
                       readonly="parent_id and not is_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_dealer_certificates" model="ir.ui.view">
        <field name="name">res.partner.form.dealer.certificates</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_int_view_certificates" type="object" class="oe_stat_button" icon="fa-certificate"
                        groups="sales_team.group_sale_salesman" invisible="not is_company and parent_id">
                    <field name="int_certificate_count" widget="statinfo" string="Certificates"/>
                </button>
            </div>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_dealer_invite_view_form" model="ir.ui.view">
        <field name="name">int.dealer.invite.form</field>
        <field name="model">int.dealer.invite</field>
        <field name="arch" type="xml">
            <form string="Create Dealer Account">
                <group>
                    <field name="lead_id" invisible="1"/>
                    <field name="who" readonly="1"/>
                    <field name="email" readonly="1"/>
                    <field name="company_id" readonly="1"/>
                    <field name="pricelist_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <p class="text-muted">
                    This sets the pricelist and the RVSB Dealer tag, then emails a link to create a password.
                    An existing login is kept.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Send invite" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

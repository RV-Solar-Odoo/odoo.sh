<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_dealer_certificate_view_list" model="ir.ui.view">
        <field name="name">int.dealer.certificate.list</field>
        <field name="model">int.dealer.certificate</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="cert_type"/>
                <field name="state_id"/>
                <field name="cert_number"/>
                <field name="expiration_date"/>
                <field name="status" widget="badge"
                       decoration-warning="status in ('pending_review', 'expiring')"
                       decoration-success="status == 'valid'"
                       decoration-danger="status == 'expired'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="int_dealer_certificate_view_form" model="ir.ui.view">
        <field name="name">int.dealer.certificate.form</field>
        <field name="model">int.dealer.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="status != 'pending_review'"
                            groups="sales_team.group_sale_manager,account.group_account_invoice"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="status != 'pending_review'"
                            groups="sales_team.group_sale_manager,account.group_account_invoice"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending_review,valid,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_file" type="object" class="oe_stat_button" icon="fa-file-o"
                                invisible="not attachment_id" string="View File"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="cert_type"/>
                            <field name="state_id"/>
                            <field name="cert_number"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiration_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="attachment_id" invisible="not attachment_id" readonly="1"/>
                            <field name="upload_name" invisible="1"/>
                            <field name="upload" filename="upload_name" string="File" invisible="attachment_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Review">
                            <field name="submitted_by_id"/>
                            <field name="reviewed_by_id"/>
                            <field name="reviewed_on"/>
                            <field name="reminder_sent_days"/>
                        </group>
                        <group string="History">
                            <field name="replaces_id"/>
                            <field name="replaced_by_id"/>
                        </group>
                    </group>
                    <field name="review_note" placeholder="Rejection note: why it can't be accepted. It's emailed to the dealer."
                           readonly="status != 'pending_review'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="int_dealer_certificate_view_search" model="ir.ui.view">
        <field name="name">int.dealer.certificate.search</field>
        <field name="model">int.dealer.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="cert_number"/>
                <field name="state_id"/>
                <filter name="pending" string="Pending Review" domain="[('status', '=', 'pending_review')]"/>
                <filter name="expiring" string="Expiring Soon" domain="[('status', '=', 'expiring')]"/>
                <filter name="expired" string="Expired" domain="[('status', '=', 'expired')]"/>
                <filter name="current" string="Current" domain="[('status', 'not in', ('superseded', 'rejected'))]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'cert_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_dealer_certificate_action" model="ir.actions.act_window">
        <field name="name">Dealer Certificates</field>
        <field name="res_model">int.dealer.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No dealer certificates yet</p>
            <p>Dealers add tax, resale and business license certificates from My Portal → Documents. Review them here.</p>
        </field>
    </record>

    <menuitem id="int_dealer_certificate_menu"
              name="Dealer Certificates"
              parent="crm.crm_menu_sales"
              action="int_dealer_certificate_action"
              sequence="6"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_tax_exemption" model="ir.ui.view">
        <field name="name">crm.lead.form.tax.exemption</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_int_open_dealer_invite" string="Create Dealer Account" type="object"
                        class="btn-primary"
                        groups="sales_team.group_sale_salesman"/>
                <button name="action_grant_tax_exemption" string="Grant Tax Exemption" type="object"
                        groups="sales_team.group_sale_manager,account.group_account_invoice"
                        invisible="not x_is_tax_exempt or x_tax_exemption_approved"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/div[1]" position="before">
                <span class="badge text-bg-success mb-2" invisible="not x_tax_exemption_approved">Exemption Approved</span>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Tax Exemption" name="tax_exemption">
                    <group>
                        <group>
                            <field name="x_is_tax_exempt"/>
                            <field name="x_tax_exemption_reason" invisible="not x_is_tax_exempt"/>
                            <field name="x_tax_exemption_document_filename" invisible="1"/>
                            <field name="x_tax_exemption_document"
                                   filename="x_tax_exemption_document_filename"
                                   invisible="not x_is_tax_exempt"/>
                            <field name="x_tax_exemption_approved" invisible="not x_is_tax_exempt"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

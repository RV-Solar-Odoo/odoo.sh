<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_tax_exemption" model="ir.ui.view">
        <field name="name">crm.lead.form.tax.exemption</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_int_open_dealer_invite" string="Create Dealer Account" type="object"
                        class="btn-primary"
                        groups="sales_team.group_sale_salesman"/>
                <button name="action_grant_tax_exemption" string="Grant Tax Exemption" type="object"
                        groups="sales_team.group_sale_manager,account.group_account_invoice"
                        invisible="not x_is_tax_exempt or x_tax_exemption_approved"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/div[1]" position="before">
                <span class="badge text-bg-success mb-2" invisible="not x_tax_exemption_approved">Exemption Approved</span>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Documents" name="int_documents">
                    <field name="int_document_ids" widget="int_lead_documents" nolabel="1"/>
                </page>
                <page string="Tax Exemption" name="tax_exemption">
                    <group>
                        <group>
                            <field name="x_is_tax_exempt"/>
                            <field name="x_tax_exemption_reason" invisible="not x_is_tax_exempt"/>
                            <field name="int_tax_certificate_status" invisible="not x_is_tax_exempt" readonly="1"/>
                            <field name="x_tax_exemption_approved" invisible="not x_is_tax_exempt"/>
                        </group>
                    </group>
                </page>
                <page string="Application" name="int_application">
                    <group>
                        <group string="Billing Address">
                            <field name="int_billing_different"/>
                            <field name="int_billing_street" invisible="not int_billing_different"/>
                            <field name="int_billing_street2" invisible="not int_billing_different"/>
                            <field name="int_billing_city" invisible="not int_billing_different"/>
                            <field name="int_billing_state_id" invisible="not int_billing_different" options="{'no_create': True}"/>
                            <field name="int_billing_state_text" invisible="not int_billing_state_text"/>
                            <field name="int_billing_zip" invisible="not int_billing_different"/>
                            <field name="int_billing_country_id" invisible="not int_billing_different" options="{'no_create': True}"/>
                        </group>
                        <group string="Social Media">
                            <field name="int_facebook"/>
                            <field name="int_instagram"/>
                            <field name="int_tiktok"/>
                            <field name="int_linkedin"/>
                        </group>
                        <group string="As Typed" invisible="not int_state_text">
                            <field name="int_state_text"/>
                            <div class="text-muted" colspan="2">This state didn't match one, so set State on the address and clear this.</div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_int_lead_document_company" model="ir.rule">
        <field name="name">Lead documents: own companies</field>
        <field name="model_id" ref="model_int_lead_document"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_int_dealer_certificate_company" model="ir.rule">
        <field name="name">Dealer certificates: own companies</field>
        <field name="model_id" ref="model_int_dealer_certificate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

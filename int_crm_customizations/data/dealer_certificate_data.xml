<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_cert_expiring" model="mail.template">
            <field name="name">Dealer Certificate: Expiring</field>
            <field name="model_id" ref="model_int_dealer_certificate"/>
            <field name="subject">Your certificate expires on {{ format_date(object.expiration_date) }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p>Your <t t-out="object.display_name"/> expires on <t t-out="format_date(object.expiration_date)"/>.
       Upload a new one in My Portal → Documents.</p>
    <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
</div>
            </field>
        </record>

        <record id="mail_cert_expired" model="mail.template">
            <field name="name">Dealer Certificate: Expired</field>
            <field name="model_id" ref="model_int_dealer_certificate"/>
            <field name="subject">Your certificate has expired</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p>Your <t t-out="object.display_name"/> expired on <t t-out="format_date(object.expiration_date)"/>.
       Please upload a current one in My Portal → Documents.</p>
    <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
</div>
            </field>
        </record>

        <record id="mail_cert_rejected" model="mail.template">
            <field name="name">Dealer Certificate: Not Accepted</field>
            <field name="model_id" ref="model_int_dealer_certificate"/>
            <field name="subject">We couldn't accept your certificate</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p>We couldn't accept the <t t-out="object.display_name"/> you uploaded:</p>
    <p t-out="object.review_note"/>
    <p>You can upload a new file in My Portal → Documents.</p>
    <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
</div>
            </field>
        </record>
    </data>

    <record id="ir_cron_dealer_certificates" model="ir.cron">
        <field name="name">Dealer Certificates: Reminders and Expiry</field>
        <field name="model_id" ref="model_int_dealer_certificate"/>
        <field name="state">code</field>
        <field name="code">model._int_cron_certificates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

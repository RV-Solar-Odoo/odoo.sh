<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_page_accessories" inherit_id="website_sale.product" name="Accessory Products on Product Page">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="after">
            <t t-set="page_accessory_products" t-value="product._get_website_accessory_product()"/>
            <div class="o_wsale_product_details_content_section o_rvs_accessory_products mb-4" t-if="page_accessory_products">
                <h5 class="mt-3 mb-0">You may also need</h5>
                <div id="suggested_products" class="d-flex flex-column align-items-stretch">
                    <div t-foreach="page_accessory_products"
                         t-as="accessory"
                         t-attf-class="d-flex gap-3 py-4 #{not accessory_last and 'border-bottom'}"
                         t-att-data-publish="accessory.website_published and 'on' or 'off'"
                         name="suggested_product"
                    >
                        <div class="o_cart_product_image">
                            <a t-att-href="accessory.website_url">
                                <div t-field="accessory.image_128" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'border rounded'}"/>
                            </a>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <a class="text-reset" t-att-href="accessory.website_url">
                                        <h6 class="align-top text-wrap" t-out="accessory.with_context(display_default_code=False).display_name"/>
                                    </a>
                                    <div class="mb-2 small text-muted" t-field="accessory.description_sale"/>
                                </div>
                                <div class="d-flex flex-column gap-2 align-items-end">
                                    <h6 class="d-flex mb-0 text-end" name="suggested_product_price_container">
                                        <t t-set="accessory_combination_info" t-value="accessory._get_combination_info_variant()"/>
                                        <del name="suggested_product_list_price"
                                             t-attf-class="me-2 text-nowrap text-muted {{'' if accessory_combination_info['has_discounted_price'] else 'd-none'}}"
                                             t-out="accessory_combination_info['list_price']"
                                             t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                        <span name="suggested_product_price"
                                              class="text-nowrap"
                                              t-out="accessory_combination_info['price']"
                                              t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                    </h6>
                                    <button class="js_add_suggested_products btn btn-primary text-nowrap"
                                            t-att-data-product-id="accessory.id"
                                            t-att-data-product-template-id="accessory.product_tmpl_id.id"
                                            t-att-data-product-type="accessory.type"
                                            t-att-data-show-quantity="is_view_active('website_sale.product_quantity')"
                                    >
                                        <i class="d-md-none fa fa-shopping-cart" role="presentation"/>
                                        <span class="d-none d-md-inline">Add to cart</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>

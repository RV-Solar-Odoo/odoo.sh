<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The dealer's own quote for their customer. It uses web.html_container, not
         web.external_layout, so nothing from the RV Solar company (logo, address,
         footer) is printed. Wholesale and margin are never rendered here. -->
    <record id="action_report_int_dealer_quote" model="ir.actions.report">
        <field name="name">Customer Quote</field>
        <field name="model">int.dealer.quote</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">int_sale_customizations.report_int_dealer_quote</field>
        <field name="report_file">int_sale_customizations.report_int_dealer_quote</field>
        <field name="print_report_name">'Quote %s' % object.name</field>
    </record>

    <template id="report_int_dealer_quote">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="quote">
                <t t-call="int_sale_customizations.report_int_dealer_quote_document"/>
            </t>
        </t>
    </template>

    <template id="report_int_dealer_quote_document">
        <t t-set="dealer" t-value="quote.partner_id"/>
        <t t-set="currency" t-value="quote.currency_id"/>
        <div class="article o_int_quote_pdf" style="font-size: 13px; color: #1f2433;">
            <div class="page">
                <!-- Dealer header -->
                <table style="width: 100%; margin-bottom: 24px;">
                    <tr>
                        <td style="width: 50%; vertical-align: top;">
                            <img t-if="dealer.image_1920" t-att-src="image_data_uri(dealer.image_512)" alt=""
                                 style="max-height: 90px; max-width: 240px;"/>
                            <h3 t-else="" style="margin: 0;" t-out="dealer.name"/>
                        </td>
                        <td style="width: 50%; vertical-align: top; text-align: right;">
                            <strong t-out="dealer.name"/>
                            <div t-if="dealer.street" t-out="dealer.street"/>
                            <div t-if="dealer.street2" t-out="dealer.street2"/>
                            <div t-if="dealer.city or dealer.state_id or dealer.zip">
                                <t t-out="dealer.city or ''"/><t t-if="dealer.city and (dealer.state_id or dealer.zip)">, </t>
                                <t t-out="dealer.state_id.code or ''"/> <t t-out="dealer.zip or ''"/>
                            </div>
                            <div t-if="dealer.phone" t-out="dealer.phone"/>
                            <div t-if="dealer.email" t-out="dealer.email"/>
                            <div t-if="dealer.website" t-out="dealer.website"/>
                        </td>
                    </tr>
                </table>

                <!-- Quote and customer -->
                <table style="width: 100%; margin-bottom: 20px;">
                    <tr>
                        <td style="width: 50%; vertical-align: top;">
                            <div style="color: #767c96; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">Prepared for</div>
                            <strong t-out="quote.customer_name"/>
                            <t t-set="address" t-value="quote.customer_address_id"/>
                            <div t-if="address.street" t-out="address.street"/>
                            <div t-if="address.street2" t-out="address.street2"/>
                            <div t-if="address.city or address.state_id or address.zip">
                                <t t-out="address.city or ''"/><t t-if="address.city and (address.state_id or address.zip)">, </t>
                                <t t-out="address.state_id.code or ''"/> <t t-out="address.zip or ''"/>
                            </div>
                            <div t-if="quote.customer_phone" t-out="quote.customer_phone"/>
                            <div t-if="quote.customer_email" t-out="quote.customer_email"/>
                        </td>
                        <td style="width: 50%; vertical-align: top; text-align: right;">
                            <h2 style="margin: 0 0 6px;">Quote <t t-out="quote.name"/></h2>
                            <div>Date: <span t-field="quote.create_date" t-options='{"widget": "date"}'/></div>
                            <div t-if="quote.valid_until">Valid until: <span t-field="quote.valid_until"/></div>
                        </td>
                    </tr>
                </table>

                <!-- Lines -->
                <table class="table table-sm o_main_table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="width: 56px;"/>
                            <th style="text-align: left;">Item</th>
                            <th style="text-align: right;">Qty</th>
                            <th style="text-align: right;">Price</th>
                            <th style="text-align: right;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="quote.line_ids" t-as="line" style="page-break-inside: avoid;">
                            <td style="vertical-align: middle;">
                                <img t-if="line.product_id.image_128" t-att-src="image_data_uri(line.product_id.image_128)" alt=""
                                     style="width: 44px; height: 44px; object-fit: contain;"/>
                            </td>
                            <td style="vertical-align: middle;">
                                <span t-out="line.name"/>
                                <div t-if="line.product_id.default_code" style="color: #767c96; font-size: 11px;">SKU <t t-out="line.product_id.default_code"/></div>
                            </td>
                            <td style="text-align: right; vertical-align: middle;">
                                <span t-out="int(line.quantity) if line.quantity == int(line.quantity) else line.quantity"/>
                            </td>
                            <td style="text-align: right; vertical-align: middle;">
                                <span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": currency}'/>
                            </td>
                            <td style="text-align: right; vertical-align: middle;">
                                <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": currency}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <table style="width: 100%; margin-top: 8px;">
                    <tr>
                        <td style="width: 60%;"/>
                        <td style="width: 40%; border-top: 2px solid #1f2433; padding-top: 6px; font-size: 16px;">
                            <strong>Total</strong>
                            <strong style="float: right;" t-field="quote.amount_untaxed" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                    <tr>
                        <td/>
                        <td style="color: #767c96; font-size: 11px; padding-top: 4px;">Before any sales tax.</td>
                    </tr>
                </table>

                <div t-if="quote.notes" style="margin-top: 24px; white-space: pre-line;">
                    <div style="color: #767c96; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">Notes</div>
                    <span t-out="quote.notes"/>
                </div>
            </div>
        </div>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_tracking_links" name="Shipment tracking links">
        <t t-foreach="links" t-as="link">
            <a t-if="link['url']" t-att-href="link['url']" target="_blank" rel="noopener noreferrer" t-out="link['number']"/>
            <span t-else="" t-out="link['number']"/>
        </t>
    </template>

    <template id="portal_my_orders_tracking" name="My Orders tracking column" inherit_id="sale.portal_my_orders">
        <xpath expr="//thead" position="before">
            <t t-set="int_tracking" t-value="orders._int_portal_shipments()"/>
        </xpath>
        <xpath expr="//th[@name='order_total']" position="before">
            <th class="text-end">Tracking</th>
        </xpath>
        <xpath expr="//td[@name='order_amount_total']" position="before">
            <td class="text-end o_int_tracking">
                <t t-set="shipment" t-value="int_tracking.get(order.id)"/>
                <t t-if="shipment and (shipment['links'] or shipment['partial'])">
                    <span t-if="shipment['partial']" class="o_int_partial">Partial</span>
                    <t t-if="shipment['links']" t-call="int_sale_customizations.portal_tracking_links">
                        <t t-set="links" t-value="shipment['links']"/>
                    </t>
                    <span t-if="not shipment['links']">—</span>
                </t>
                <span t-else="">—</span>
            </td>
        </xpath>
    </template>

    <template id="portal_delivery_orders_all" name="All delivery orders on the order page" inherit_id="sale_stock.sale_order_portal_content_inherit_sale_stock">
        <xpath expr="//t[@t-set='latest_delivery_orders']" position="attributes">
            <attribute name="t-value">delivery_orders.sorted('create_date', reverse=True)</attribute>
        </xpath>
        <xpath expr="//h5[@class='mb-1']" position="replace">
            <h5 class="mb-1">
                Delivery Orders
                <span t-if="sale_order._int_portal_shipments()[sale_order.id]['partial']" class="o_int_partial">Partial</span>
            </h5>
        </xpath>
    </template>

    <template id="portal_delivery_tracking_links" name="Delivery tracking links" inherit_id="stock_delivery.sale_order_portal_content_inherit_sale_stock_inherit_website_sale">
        <xpath expr="//div[@t-if='picking.carrier_tracking_ref']" position="replace">
            <div t-if="picking.carrier_tracking_ref" class="small o_int_delivery_tracking">
                Tracking:
                <t t-call="int_sale_customizations.portal_tracking_links">
                    <t t-set="links" t-value="picking._int_portal_tracking_links()"/>
                </t>
            </div>
        </xpath>
    </template>
</odoo>

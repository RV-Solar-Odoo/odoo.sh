<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_tracking_links" name="Shipment tracking links">
        <t t-foreach="links" t-as="link">
            <a t-if="link['url']" t-att-href="link['url']" target="_blank" rel="noopener noreferrer" t-out="link['number']"/>
            <span t-else="" t-out="link['number']"/>
        </t>
    </template>

    <template id="portal_my_orders_tracking" name="My Orders tracking column" inherit_id="sale.portal_my_orders">
        <xpath expr="//thead" position="before">
            <t t-set="int_tracking" t-value="orders._int_portal_shipments()"/>
        </xpath>
        <xpath expr="//th[@name='order_total']" position="before">
            <th class="text-end">Tracking</th>
        </xpath>
        <xpath expr="//td[@name='order_amount_total']" position="before">
            <td class="text-end o_int_tracking">
                <t t-set="shipment" t-value="int_tracking.get(order.id)"/>
                <t t-if="shipment and (shipment['links'] or shipment['partial'])">
                    <span t-if="shipment['partial']" class="o_int_partial">Partial</span>
                    <t t-if="shipment['links']" t-call="int_sale_customizations.portal_tracking_links">
                        <t t-set="links" t-value="shipment['links']"/>
                    </t>
                    <span t-if="not shipment['links']">—</span>
                </t>
                <span t-else="">—</span>
            </td>
        </xpath>
    </template>

    <template id="portal_delivery_orders_all" name="All delivery orders on the order page" inherit_id="sale_stock.sale_order_portal_content_inherit_sale_stock">
        <xpath expr="//t[@t-set='latest_delivery_orders']" position="attributes">
            <attribute name="t-value">delivery_orders.sorted('create_date', reverse=True)</attribute>
        </xpath>
        <xpath expr="//div[@t-if='delivery_orders']/h5[@class='mb-1']" position="replace">
            <h5 class="mb-1">
                Deliveries
                <span t-if="sale_order._int_portal_shipments()[sale_order.id]['partial']" class="o_int_partial">Partial</span>
            </h5>
        </xpath>
        <xpath expr="//div[@name='delivery_details']/a" position="attributes">
            <attribute name="t-att-href">'/my/deliveries/%s' % picking.id</attribute>
        </xpath>
    </template>

    <template id="portal_delivery_tracking_links" name="Delivery tracking links" inherit_id="stock_delivery.sale_order_portal_content_inherit_sale_stock_inherit_website_sale">
        <xpath expr="//div[@t-if='picking.carrier_tracking_ref']" position="replace">
            <div t-if="picking.carrier_tracking_ref" class="small o_int_delivery_tracking">
                Tracking:
                <t t-call="int_sale_customizations.portal_tracking_links">
                    <t t-set="links" t-value="picking._int_portal_tracking_links()"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="portal_my_home_orders_extra" name="Deliveries and PO upload" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-if="request.env.user.int_portal_can('view_orders')" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/int_sale_customizations/static/src/img/delivery.svg'"/>
                <t t-set="title">Deliveries</t>
                <t t-set="text">All shipments, including backorders</t>
                <t t-set="url" t-value="'/my/deliveries'"/>
                <t t-set="placeholder_count" t-value="'int_delivery_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
            <t t-if="request.env.user.int_portal_can('upload_po')" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                <t t-set="title">Upload a PO</t>
                <t t-set="text">Add a spreadsheet to your cart, or send a PDF</t>
                <t t-set="url" t-value="'/my/po-upload'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_orders_tools" name="My Orders search, pins, and export" inherit_id="sale.portal_my_orders">
        <xpath expr="//t[@t-call='portal.portal_searchbar']" position="after">
            <div t-if="int_search_error" class="alert alert-warning" role="alert" t-out="int_search_error"/>
            <form method="get" action="/my/orders" class="row g-2 mb-3">
                <div class="col-md-3">
                    <select class="form-select" name="search_in">
                        <option value="all" t-att-selected="search_in == 'all'">All</option>
                        <option value="name" t-att-selected="search_in == 'name'">Order #</option>
                        <option value="po" t-att-selected="search_in == 'po'">PO #</option>
                        <option value="ship" t-att-selected="search_in == 'ship'">Ship-to</option>
                        <option value="product" t-att-selected="search_in == 'product'">Product / SKU</option>
                        <option value="serial" t-att-selected="search_in == 'serial'">Serial #</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input class="form-control" name="search" t-att-value="search" placeholder="Search"/>
                </div>
                <div class="col-md-2">
                    <input class="form-control" type="date" name="date_begin" t-att-value="date_begin"/>
                </div>
                <div class="col-md-2">
                    <input class="form-control" type="date" name="date_end" t-att-value="date_end"/>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit">Search</button>
                </div>
                <div class="col-md-4">
                    <select class="form-select" name="filterby">
                        <option value="all" t-att-selected="filterby == 'all'">All</option>
                        <option value="open" t-att-selected="filterby == 'open'">Open</option>
                        <option value="shipped" t-att-selected="filterby == 'shipped'">Shipped</option>
                        <option value="backordered" t-att-selected="filterby == 'backordered'">Backordered</option>
                        <option value="cancelled" t-att-selected="filterby == 'cancelled'">Cancelled</option>
                        <option value="cancel_requested" t-att-selected="filterby == 'cancel_requested'">Cancellation requested</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select class="form-select" name="sortby">
                        <option value="date" t-att-selected="sortby == 'date'">Newest</option>
                        <option value="date_asc" t-att-selected="sortby == 'date_asc'">Oldest</option>
                        <option value="name" t-att-selected="sortby == 'name'">Order #</option>
                        <option value="amount" t-att-selected="sortby == 'amount'">Total</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2 align-items-center" t-if="request.env.user.int_portal_can('export_orders')">
                    <a class="btn btn-light" t-attf-href="/my/orders/export?export_format=xlsx&amp;search={{ search }}&amp;search_in={{ search_in }}&amp;filterby={{ filterby }}&amp;date_begin={{ date_begin }}&amp;date_end={{ date_end }}">Export XLSX</a>
                    <a class="btn btn-light" t-attf-href="/my/orders/export?export_format=csv&amp;search={{ search }}&amp;search_in={{ search_in }}&amp;filterby={{ filterby }}&amp;date_begin={{ date_begin }}&amp;date_end={{ date_end }}">CSV</a>
                </div>
            </form>
        </xpath>
        <xpath expr="//thead/tr/th[span[hasclass('d-md-inline')]]" position="before">
            <th t-if="request.env.user.int_portal_can('pin_orders')" class="o_int_pin_col"><span class="visually-hidden">Pin</span></th>
        </xpath>
        <xpath expr="//t[@t-foreach='orders']/tr/td[1]" position="before">
            <td t-if="request.env.user.int_portal_can('pin_orders')" class="o_int_pin_col">
                <t t-call="int_sale_customizations.portal_order_pin"/>
            </td>
        </xpath>
        <xpath expr="//th[@name='order_total']" position="after">
            <th t-if="request.env.user.int_portal_can('place_orders')" class="text-end"><span class="visually-hidden">Reorder</span></th>
        </xpath>
        <xpath expr="//td[@name='order_amount_total']" position="after">
            <td t-if="request.env.user.int_portal_can('place_orders')" class="text-end">
                <t t-call="int_sale_customizations.portal_order_reorder"/>
            </td>
        </xpath>
    </template>

    <template id="portal_order_pin" name="Order pin">
        <form t-if="request.env.user.int_portal_can('pin_orders')" t-attf-action="/my/orders/{{ order.id }}/pin" method="post" class="d-inline">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <button class="btn btn-link p-0 o_int_pin_btn" type="submit"
                    t-att-aria-label="'Unpin' if order in request.env.user.int_pinned_order_ids else 'Pin'"
                    t-att-title="'Unpin' if order in request.env.user.int_pinned_order_ids else 'Pin'">
                <i t-attf-class="fa #{'fa-star' if order in request.env.user.int_pinned_order_ids else 'fa-star-o'}" aria-hidden="true"/>
            </button>
        </form>
    </template>

    <template id="portal_order_reorder" name="Order reorder">
        <form t-if="request.env.user.int_portal_can('place_orders')" t-attf-action="/my/orders/{{ order.id }}/reorder" method="post" class="d-inline">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <button class="btn btn-outline-primary btn-sm" type="submit">Reorder</button>
        </form>
    </template>

    <template id="portal_order_actions" name="Order pin and reorder">
        <span class="d-inline-flex align-items-center gap-3">
            <t t-call="int_sale_customizations.portal_order_pin"/>
            <t t-call="int_sale_customizations.portal_order_reorder"/>
        </span>
    </template>

    <template id="portal_order_cancel" name="Request cancellation" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='introduction']" position="after">
            <div t-if="request.params.get('int_error')" class="alert alert-warning" role="alert" t-out="request.params.get('int_error')"/>
            <div t-if="sale_order.int_cancel_state == 'requested'" class="alert alert-info" role="alert">
                Cancellation requested — we'll confirm shortly.
            </div>
            <div t-if="sale_order.int_cancel_state == 'denied'" class="alert alert-warning" role="alert">
                The cancellation was denied.
                <span t-if="sale_order.int_cancel_decision_note" t-out="sale_order.int_cancel_decision_note"/>
            </div>
            <p t-if="sale_order.int_ship_location_type" class="text-muted">
                <span t-if="sale_order.int_ship_location_type == 'commercial'">Commercial</span>
                <span t-if="sale_order.int_ship_location_type == 'residential'">Residential</span>
                <span t-if="sale_order.int_ship_has_dock"> · Loading dock</span>
                <span t-if="sale_order.int_ship_has_forklift"> · Forklift</span>
            </p>
            <t t-set="int_can_cancel" t-value="report_type != 'pdf' and request.env.user.int_portal_can('cancel_orders') and not sale_order._int_cancel_blocked_reason() and sale_order._int_owned_by(request.env.user)"/>
            <div class="mb-3" t-if="report_type != 'pdf'">
                <t t-call="int_sale_customizations.portal_order_actions">
                    <t t-set="order" t-value="sale_order"/>
                </t>
                <button t-if="int_can_cancel" type="button" class="btn btn-link btn-sm p-0 ms-2"
                        data-bs-toggle="modal" data-bs-target="#int_cancel_modal">Request cancellation</button>
            </div>
            <div t-if="int_can_cancel" class="modal fade" id="int_cancel_modal" tabindex="-1" aria-labelledby="int_cancel_modal_title" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form t-attf-action="/my/orders/{{ sale_order.id }}/cancel" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="modal-header">
                                <h5 class="modal-title" id="int_cancel_modal_title">Request cancellation</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body">
                                <div t-if="request.params.get('int_error')" class="alert alert-warning" role="alert" t-out="request.params.get('int_error')"/>
                                <label class="col-form-label" for="int_cancel_reason">Reason</label>
                                <select class="form-select mb-2" name="reason" id="int_cancel_reason" required="required">
                                    <option value="no_longer_needed">No longer needed</option>
                                    <option value="ordered_wrong_item">Ordered the wrong item</option>
                                    <option value="found_elsewhere">Found it elsewhere</option>
                                    <option value="delay">Delay</option>
                                    <option value="other">Other</option>
                                </select>
                                <label class="col-form-label" for="int_cancel_note">Note</label>
                                <textarea class="form-control mb-2" name="note" id="int_cancel_note"/>
                                <div t-if="sale_order._int_cancel_needs_refund()">
                                    <label class="form-check">
                                        <input class="form-check-input" type="radio" name="preference" value="store_credit" checked="checked"/>
                                        Store credit
                                        <span class="text-muted d-block">Applied instantly to your next order once approved.</span>
                                    </label>
                                    <label class="form-check">
                                        <input class="form-check-input" type="radio" name="preference" value="original"/>
                                        Original payment method
                                    </label>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                                <button class="btn btn-primary" type="submit">Request cancellation</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <script t-if="int_can_cancel and request.params.get('int_error')">
                document.addEventListener("DOMContentLoaded", function () {
                    var button = document.querySelector("[data-bs-target='#int_cancel_modal']");
                    if (button) {
                        button.click();
                    }
                });
            </script>
        </xpath>
        <xpath expr="//div[@id='sale_invoices']" position="attributes">
            <attribute name="t-if">invoices and sale_order.state in ['sale', 'cancel'] and request.env.user.int_portal_can('view_invoices')</attribute>
        </xpath>
    </template>

    <template id="portal_store_credit" name="Store credit card" inherit_id="int_account_customizations.portal_credit_card">
        <xpath expr="//div[@id='int_account_cards']" position="inside">
            <t t-set="int_store_credit" t-value="request.env.user._int_portal_store_credit()"/>
            <div t-if="int_store_credit" class="o_int_summary_card">
                <h3>Store credit</h3>
                <strong t-out="int_store_credit['amount']" t-options="{'widget': 'monetary', 'display_currency': int_store_credit['currency']}"/>
            </div>
        </xpath>
    </template>

    <template id="portal_deliveries" name="Deliveries">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Deliveries</t>
            <h3 class="my-3">Deliveries</h3>
            <form method="get" action="/my/deliveries" class="row g-2 mb-3">
                <div class="col-md-4">
                    <select class="form-select" name="filterby" onchange="this.form.submit()">
                        <option value="all" t-att-selected="filterby == 'all'">All</option>
                        <option value="open" t-att-selected="filterby == 'open'">Open</option>
                        <option value="shipped" t-att-selected="filterby == 'shipped'">Shipped</option>
                        <option value="backordered" t-att-selected="filterby == 'backordered'">Backordered</option>
                    </select>
                </div>
            </form>
            <div t-if="not deliveries" class="alert alert-info" role="alert">
                <t t-if="filterby == 'backordered'">No backorders. Everything you've ordered has shipped.</t>
                <t t-else="">No deliveries yet.</t>
            </div>
            <t t-else="" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Delivery</th>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Tracking</th>
                    </tr>
                </thead>
                <t t-foreach="deliveries" t-as="delivery">
                    <t t-set="int_status" t-value="delivery._int_portal_delivery_status()"/>
                    <tr>
                        <td>
                            <a t-attf-href="/my/deliveries/{{ delivery.id }}" t-out="delivery.name"/>
                        </td>
                        <td>
                            <a t-if="delivery.sale_id" t-att-href="delivery.sale_id.get_portal_url()" t-out="delivery.sale_id.name"/>
                        </td>
                        <td>
                            <span t-if="delivery.state == 'done'" t-field="delivery.date_done" t-options="{'widget': 'date'}"/>
                            <span t-else="" t-field="delivery.scheduled_date" t-options="{'widget': 'date'}"/>
                        </td>
                        <td>
                            <span t-attf-class="badge rounded-pill {{ int_status[2] }}" t-out="int_status[1]"/>
                        </td>
                        <td class="o_int_tracking">
                            <t t-set="links" t-value="delivery._int_portal_tracking_links()"/>
                            <t t-if="links" t-call="int_sale_customizations.portal_tracking_links"/>
                            <span t-else="">—</span>
                        </td>
                    </tr>
                </t>
            </t>
            <div t-if="pager" class="d-flex justify-content-center mt-3">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <template id="portal_delivery" name="Delivery">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="delivery.name"/>
            <div class="d-flex justify-content-between align-items-center my-3">
                <h3 class="mb-0">Delivery <t t-out="delivery.name"/></h3>
                <t t-set="int_status" t-value="delivery._int_portal_delivery_status()"/>
                <span t-attf-class="badge rounded-pill {{ int_status[2] }}" t-out="int_status[1]"/>
            </div>
            <div class="row">
                <div class="col-12 col-lg-6 mb-4">
                    <h5 class="mb-1">Shipment</h5>
                    <hr class="mt-1 mb-2"/>
                    <p t-if="delivery.backorder_id" class="mb-1">
                        Backorder of <t t-out="delivery.backorder_id.name"/>
                    </p>
                    <p class="mb-1" t-if="delivery.sale_id">
                        Order:
                        <a t-att-href="delivery.sale_id.get_portal_url()" t-out="delivery.sale_id.name"/>
                    </p>
                    <p class="mb-1" t-if="delivery.sale_id.client_order_ref">
                        PO #: <t t-out="delivery.sale_id.client_order_ref"/>
                    </p>
                    <p class="mb-1">
                        <t t-if="delivery.state == 'done'">Shipped</t>
                        <t t-else="">Expected</t>:
                        <span t-if="delivery.state == 'done'" t-field="delivery.date_done" t-options="{'widget': 'date'}"/>
                        <span t-else="" t-field="delivery.scheduled_date" t-options="{'widget': 'date'}"/>
                    </p>
                    <p class="mb-1 o_int_delivery_tracking">
                        Tracking:
                        <t t-set="links" t-value="delivery._int_portal_tracking_links()"/>
                        <t t-if="links" t-call="int_sale_customizations.portal_tracking_links"/>
                        <span t-else="">—</span>
                    </p>
                    <p t-if="delivery.sale_id.access_token" class="mb-0">
                        <a t-attf-href="/my/picking/pdf/{{ delivery.id }}?access_token={{ delivery.sale_id.access_token }}">Delivery slip</a>
                    </p>
                </div>
                <div class="col-12 col-lg-6 mb-4">
                    <h5 class="mb-1">Ship to</h5>
                    <hr class="mt-1 mb-2"/>
                    <div t-field="delivery.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'phone']}"/>
                </div>
            </div>
            <h5 class="mb-1">Products</h5>
            <hr class="mt-1 mb-2"/>
            <t t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Ordered</th>
                        <th class="text-end">Done</th>
                    </tr>
                </thead>
                <t t-foreach="delivery._int_portal_delivery_moves()" t-as="move">
                    <tr>
                        <td>
                            <span t-if="move.product_id.default_code" t-out="move.product_id.default_code"/>
                            <span t-out="move.product_id.name"/>
                        </td>
                        <td class="text-end" t-out="move.product_uom_qty"/>
                        <td class="text-end" t-out="move.quantity"/>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_reorder_review" name="Reorder review">
        <t t-call="portal.portal_layout">
            <h3>Some products will not be added</h3>
            <p>Nothing has been added to the cart yet.</p>
            <ul>
                <li t-foreach="int_skipped" t-as="item">
                    <span t-out="item[0]"/> — <span t-out="item[1]"/>
                </li>
            </ul>
            <form t-attf-action="/my/orders/{{ sale_order.id }}/reorder" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="confirm" value="1"/>
                <button class="btn btn-primary" type="submit">Add the available products</button>
                <a class="btn btn-light" t-att-href="sale_order.get_portal_url()">Back</a>
            </form>
        </t>
    </template>

    <template id="portal_po_upload" name="Upload a PO">
        <t t-call="portal.portal_layout">
            <h3>Upload a PO</h3>
            <div t-if="int_po_done" class="alert alert-success" role="alert">
                We've received your PO and will send a quote shortly.
            </div>
            <div t-if="int_error" class="alert alert-warning" role="alert" t-out="int_error"/>
            <p><a href="/my/po-template.xlsx">Download the spreadsheet template</a></p>
            <form action="/my/po-upload/submit" method="post" enctype="multipart/form-data" class="row g-2">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="col-md-6">
                    <input class="form-control" type="file" name="po_file" accept=".xlsx,.pdf" required="required"/>
                </div>
                <div class="col-md-4">
                    <input class="form-control" name="po_number" placeholder="PO number (PDF, optional)"/>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit">Upload</button>
                </div>
            </form>
        </t>
    </template>

    <template id="portal_po_result" name="PO upload result">
        <t t-call="portal.portal_layout">
            <h3>Purchase order <t t-out="int_po_number"/></h3>
            <p t-if="int_added"><t t-out="len(int_added)"/> line(s) added to the cart.</p>
            <ul t-if="int_rejected">
                <li t-foreach="int_rejected" t-as="item">
                    <span t-out="item[0] or 'Row'"/> — <span t-out="item[1]"/>
                </li>
            </ul>
            <a class="btn btn-primary" href="/shop/cart">View cart</a>
        </t>
    </template>

    <template id="portal_breadcrumbs_orders" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'int_delivery' and not delivery" class="breadcrumb-item">Deliveries</li>
            <li t-if="page_name == 'int_delivery' and delivery" class="breadcrumb-item">
                <a href="/my/deliveries">Deliveries</a>
            </li>
            <li t-if="page_name == 'int_delivery' and delivery" class="breadcrumb-item" t-out="delivery.name"/>
            <li t-if="page_name == 'int_po'" class="breadcrumb-item">Upload a PO</li>
        </xpath>
    </template>

    <template id="product_add_to_cart_role" inherit_id="website_sale.cta_wrapper">
        <xpath expr="//a[@id='add_to_cart']" position="attributes">
            <attribute name="t-if">not request.env.user.int_portal_ordering_blocked()</attribute>
        </xpath>
        <xpath expr="//a[@id='add_to_cart']" position="after">
            <span t-if="request.env.user.int_portal_ordering_blocked()" class="text-muted">Ask your account owner to order.</span>
        </xpath>
    </template>
</odoo>

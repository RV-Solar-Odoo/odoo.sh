<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- My Orders tabs: All Orders, Favorite Orders, Backorders, Quotes.
         ``int_tab`` is the current one, ``int_tab_counts`` the numbers. -->
    <template id="portal_order_tabs" name="My Orders tabs">
        <nav class="o_int_order_tabs" aria-label="Your Orders">
            <t t-foreach="[('all', 'All Orders', '/my/orders'), ('favorites', 'Favorite Orders', '/my/favorites'), ('backorders', 'Backorders', '/my/backorders'), ('quotes', 'Quotes', '/my/quotes')]" t-as="int_tab_info">
                <a t-att-href="int_tab_info[2]"
                   t-attf-class="o_int_order_tab #{'active' if int_tab == int_tab_info[0] else ''}"
                   t-att-aria-current="'page' if int_tab == int_tab_info[0] else None">
                    <t t-out="int_tab_info[1]"/>
                    <span class="o_int_order_tab_count" t-out="(int_tab_counts or {}).get(int_tab_info[0], 0)"/>
                </a>
            </t>
        </nav>
    </template>

    <!-- "Saved … · View" or "Removed … · Undo" after a favorite changes. -->
    <template id="portal_favorite_notice" name="Favorite saved or removed">
        <t t-set="int_notice" t-value="int_fav_notice or request.env['int.favorite.order']._int_notice(request.env.user, request.website.company_id or request.env.company, request.params)"/>
        <div t-if="int_notice" class="o_int_fav_notice" role="status">
            <i class="fa fa-star" aria-hidden="true"/>
            <t t-if="int_notice['kind'] == 'saved'">
                <span>Saved “<t t-out="int_notice['favorite'].name"/>” to Favorite Orders.</span>
                <a t-attf-href="/my/favorites?open={{ int_notice['favorite'].id }}">View</a>
            </t>
            <t t-else="">
                <span>Removed “<t t-out="int_notice['favorite'].name"/>” from Favorite Orders.</span>
                <form t-attf-action="/my/favorites/{{ int_notice['favorite'].id }}/restore" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="redirect" t-att-value="request.httprequest.path"/>
                    <button type="submit" class="btn btn-link p-0">Undo</button>
                </form>
            </t>
        </div>
    </template>

    <!-- Save to Favorite Orders, opened by an empty star. The script fills in
         the order and its number as the default name. -->
    <template id="portal_favorite_modal" name="Save to Favorite Orders">
        <div t-if="request.env.user.int_portal_can('pin_orders')" class="modal fade o_int_fav_modal" id="int_fav_modal" tabindex="-1" aria-labelledby="int_fav_modal_title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content js-int-fav-form" method="post" action="/my/orders">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="redirect" t-att-value="int_back_url or '/my/orders'"/>
                    <div class="modal-header">
                        <h2 class="modal-title" id="int_fav_modal_title"><i class="fa fa-star" aria-hidden="true"/> Save to Favorite Orders</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                    </div>
                    <div class="modal-body">
                        <label for="int_fav_name" class="form-label">Name</label>
                        <input id="int_fav_name" name="name" class="form-control" maxlength="120" autocomplete="off"/>
                        <p class="o_int_fav_hint">Saves the products on this order for everyone at <t t-out="request.env.user.partner_id.commercial_partner_id.name"/>. You can rename it or change the products later.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </template>

    <template id="portal_favorite_thumb" name="Favorite product picture">
        <img class="o_int_fav_thumb" t-attf-src="/web/image/product.product/{{ product.id }}/image_128" alt="" loading="lazy"/>
    </template>

    <!-- Favorite Orders tab: one collapsed row per favorite; open one to pick
         products and quantities. -->
    <template id="portal_my_favorites" name="Favorite Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Your Orders</t>
            </t>
            <t t-call="int_sale_customizations.portal_order_tabs"/>
            <t t-call="int_sale_customizations.portal_favorite_notice"/>
            <div t-if="int_error" class="alert alert-warning" role="alert" t-out="int_error"/>
            <p class="o_int_tab_hint">Saved lists of products for everyone at <t t-out="request.env.user.partner_id.commercial_partner_id.name"/>. Star an order on All Orders, or save your cart, to add one.</p>
            <div t-if="not favorites" class="o_int_fav_empty">No favorite orders yet.</div>
            <div class="o_int_favs">
                <t t-foreach="favorites" t-as="fav">
                    <t t-set="is_open" t-value="int_open_id == fav.id"/>
                    <article t-attf-class="o_int_fav #{'o_int_fav_open' if is_open else ''}">
                        <div class="o_int_fav_head">
                            <form t-if="int_can_edit_favorites" t-attf-action="/my/favorites/{{ fav.id }}/delete" method="post" class="o_int_fav_star">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-link p-0" t-attf-aria-label="Remove {{ fav.name }} from Favorite Orders" title="Remove from Favorite Orders">
                                    <i class="fa fa-star" aria-hidden="true"/>
                                </button>
                            </form>
                            <span t-else="" class="o_int_fav_star"><i class="fa fa-star" aria-hidden="true"/></span>
                            <button type="button" class="o_int_fav_title" data-bs-toggle="collapse"
                                    t-attf-data-bs-target="#int_fav_{{ fav.id }}" t-att-aria-expanded="'true' if is_open else 'false'"
                                    t-attf-aria-controls="int_fav_{{ fav.id }}">
                                <span class="o_int_fav_name" t-out="fav.name"/>
                                <span class="o_int_fav_meta">
                                    <t t-if="fav.source_order_id">From order <t t-out="fav.source_order_id.name"/> · <t t-out="fav.source_order_id.date_order" t-options="{'widget': 'date'}"/></t>
                                    <t t-else="">Saved from a cart · <t t-out="fav.create_date" t-options="{'widget': 'date'}"/></t>
                                </span>
                            </button>
                            <span class="o_int_fav_thumbs" aria-hidden="true">
                                <t t-foreach="fav.line_ids[:4]" t-as="thumb_line">
                                    <t t-call="int_sale_customizations.portal_favorite_thumb">
                                        <t t-set="product" t-value="thumb_line.product_id"/>
                                    </t>
                                </t>
                            </span>
                            <span class="o_int_fav_count" t-out="fav._int_count_label()"/>
                            <span class="o_int_fav_total" t-out="int_totals.get(fav.id, 0)" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            <form t-if="int_can_order" t-attf-action="/my/favorites/{{ fav.id }}/cart" method="post" class="o_int_fav_reorder">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-primary">Reorder</button>
                            </form>
                            <button type="button" class="o_int_fav_chevron" data-bs-toggle="collapse"
                                    t-attf-data-bs-target="#int_fav_{{ fav.id }}" t-att-aria-expanded="'true' if is_open else 'false'"
                                    t-attf-aria-controls="int_fav_{{ fav.id }}" t-attf-aria-label="Show the products in {{ fav.name }}">
                                <i class="fa fa-angle-down" aria-hidden="true"/>
                            </button>
                        </div>
                        <div t-attf-id="int_fav_{{ fav.id }}" t-attf-class="collapse #{'show' if is_open else ''}">
                            <form t-attf-action="/my/favorites/{{ fav.id }}/cart" method="post" class="o_int_fav_body">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="selected" value="1"/>
                                <t t-foreach="fav.line_ids" t-as="line">
                                    <div class="o_int_fav_line">
                                        <input t-if="int_can_order" type="checkbox" class="form-check-input" t-attf-name="line_{{ line.id }}" value="1" checked="checked"
                                               t-attf-aria-label="Include {{ line.product_id.display_name }}"/>
                                        <t t-call="int_sale_customizations.portal_favorite_thumb">
                                            <t t-set="product" t-value="line.product_id"/>
                                        </t>
                                        <span class="o_int_fav_product">
                                            <span t-out="line.product_id.with_context(display_default_code=False).display_name"/>
                                            <span t-if="line.product_id.default_code" class="o_int_fav_sku">SKU <t t-out="line.product_id.default_code"/></span>
                                        </span>
                                        <span class="o_int_fav_price"><t t-out="int_prices.get(line.product_id.id, 0)" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/> each</span>
                                        <span t-if="int_can_order" class="o_int_step">
                                            <button type="button" data-int-step="-1" aria-label="Fewer">−</button>
                                            <input type="number" min="1" max="9999" step="1" t-attf-name="qty_{{ line.id }}" t-att-value="line._int_qty_label()" aria-label="Quantity"/>
                                            <button type="button" data-int-step="1" aria-label="More">+</button>
                                        </span>
                                        <span t-else="" class="o_int_fav_qty">Qty <t t-out="line._int_qty_label()"/></span>
                                    </div>
                                </t>
                                <div class="o_int_fav_foot">
                                    <span class="o_int_fav_links">
                                        <a t-if="int_can_edit_favorites" t-attf-href="/my/favorites/{{ fav.id }}/edit"><i class="fa fa-pencil" aria-hidden="true"/> Edit Favorite</a>
                                        <a t-if="fav.source_order_id in int_owned_orders" t-att-href="fav.source_order_id.get_portal_url()" class="o_int_fav_muted">View Original Order <t t-out="fav.source_order_id.name"/></a>
                                    </span>
                                    <button t-if="int_can_order" type="submit" class="btn btn-primary">Add Selected to Cart</button>
                                </div>
                            </form>
                        </div>
                    </article>
                </t>
            </div>
        </t>
    </template>

    <!-- Edit Favorite: rename, quantities, remove products, add products. -->
    <template id="portal_favorite_edit" name="Edit Favorite">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Your Orders</t>
            </t>
            <t t-call="int_sale_customizations.portal_order_tabs"/>
            <div t-if="int_error" class="alert alert-warning" role="alert" t-out="int_error"/>
            <form class="o_int_fav o_int_fav_open o_int_fav_edit js-int-fav-edit" method="post" t-attf-action="/my/favorites/{{ favorite.id }}/save">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="o_int_fav_edit_head">
                    <label class="o_int_fav_name_field">
                        Favorite name
                        <input type="text" name="name" class="form-control" maxlength="120" required="required" t-att-value="favorite.name"/>
                    </label>
                    <span class="o_int_fav_meta">
                        <t t-if="favorite.source_order_id">From order <t t-out="favorite.source_order_id.name"/> · </t>
                        Shared with everyone at <t t-out="favorite.partner_id.name"/>
                    </span>
                </div>
                <t t-foreach="favorite.line_ids" t-as="line">
                    <div class="o_int_fav_line" data-int-line="1">
                        <t t-call="int_sale_customizations.portal_favorite_thumb">
                            <t t-set="product" t-value="line.product_id"/>
                        </t>
                        <span class="o_int_fav_product">
                            <span t-out="line.product_id.with_context(display_default_code=False).display_name"/>
                            <span t-if="line.product_id.default_code" class="o_int_fav_sku">SKU <t t-out="line.product_id.default_code"/></span>
                        </span>
                        <span class="o_int_fav_price"><t t-out="int_prices.get(line.product_id.id, 0)" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/> each</span>
                        <span class="o_int_step">
                            <button type="button" data-int-step="-1" aria-label="Fewer">−</button>
                            <input type="number" min="0" max="9999" step="1" t-attf-name="qty_{{ line.id }}" t-att-value="line._int_qty_label()" aria-label="Quantity"/>
                            <button type="button" data-int-step="1" aria-label="More">+</button>
                        </span>
                        <input type="hidden" t-attf-name="remove_{{ line.id }}" value="0" class="js-int-fav-remove-input"/>
                        <button type="button" class="o_int_fav_remove js-int-fav-remove" t-attf-aria-label="Remove {{ line.product_id.display_name }}" title="Remove">
                            <i class="fa fa-trash-o" aria-hidden="true"/>
                        </button>
                    </div>
                </t>
                <div class="js-int-fav-added"/>
                <div class="o_int_fav_add">
                    <label class="o_int_fav_add_field">
                        <i class="fa fa-plus" aria-hidden="true"/>
                        <input type="search" class="js-int-fav-search" placeholder="Add a product by name or SKU" aria-label="Add a product by name or SKU" autocomplete="off"/>
                    </label>
                    <ul class="o_int_fav_results js-int-fav-results d-none" role="listbox" aria-label="Matching products"/>
                </div>
                <div class="o_int_fav_foot">
                    <button type="submit" form="int_fav_delete_form" class="o_int_fav_delete">Delete This Favorite</button>
                    <span class="o_int_fav_links">
                        <a t-attf-href="/my/favorites?open={{ favorite.id }}" class="btn btn-outline-primary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </span>
                </div>
            </form>
            <form id="int_fav_delete_form" method="post" t-attf-action="/my/favorites/{{ favorite.id }}/delete">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="redirect" value="/my/favorites"/>
            </form>
        </t>
    </template>

    <!-- Before adding a favorite to the cart: products that can no longer be ordered online. -->
    <template id="portal_favorite_review" name="Favorite: products not available">
        <t t-call="portal.portal_layout">
            <h3 class="mt-3">Some products can't be added</h3>
            <p>Nothing has been added to your cart yet.</p>
            <ul>
                <li t-foreach="int_skipped" t-as="item">
                    <span t-out="item[0]"/> — <span t-out="item[1]"/>
                </li>
            </ul>
            <form t-attf-action="/my/favorites/{{ favorite.id }}/cart" method="post" class="d-flex gap-2 flex-wrap">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="confirm" value="1"/>
                <t t-if="int_selected is not None">
                    <input type="hidden" name="selected" value="1"/>
                    <t t-foreach="int_selected.items()" t-as="int_pick">
                        <input type="hidden" t-attf-name="line_{{ int_pick[0] }}" value="1"/>
                        <input type="hidden" t-attf-name="qty_{{ int_pick[0] }}" t-att-value="int_pick[1]"/>
                    </t>
                </t>
                <button t-if="int_addable" class="btn btn-primary" type="submit">Add the Available Products</button>
                <a class="btn btn-outline-primary" t-attf-href="/my/favorites?open={{ favorite.id }}">Back</a>
            </form>
        </t>
    </template>

    <!-- Quotes tab: Odoo's quotations page, under the same tabs. -->
    <template id="portal_my_quotations_tabs" name="Quotes tab" inherit_id="sale.portal_my_quotations">
        <xpath expr="//t[@t-call='portal.portal_searchbar']/t[@t-set='title']" position="replace">
            <t t-set="title">Your Orders</t>
        </xpath>
        <xpath expr="//t[@t-call='portal.portal_searchbar']" position="after">
            <t t-call="int_sale_customizations.portal_order_tabs"/>
            <p class="o_int_tab_hint">
                Quotes waiting for you to accept. Open one to review, sign and pay.
                <a t-if="request.env.user.int_portal_can('create_quotes')" href="/my/customer-quotes">Quotes you write for your own customers are separate.</a>
            </p>
        </xpath>
    </template>

    <!-- Quotes live in My Orders now: no separate Quotations box on My Portal. -->
    <template id="portal_my_home_no_quotes" name="No Quotations box on My Portal" inherit_id="sale.portal_my_home_sale">
        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-set='url' and @t-value=&quot;'/my/quotes'&quot;]]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template id="portal_favorite_breadcrumbs" name="Favorite Orders breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <t t-if="page_name == 'int_favorite' and favorite">
                <li class="breadcrumb-item"><a href="/my/orders">Sales Orders</a></li>
                <li class="breadcrumb-item"><a href="/my/favorites">Favorite Orders</a></li>
                <li class="breadcrumb-item active" t-out="favorite.name"/>
            </t>
        </xpath>
    </template>

    <!-- Cart: Save Cart as a Favorite, under Checkout. -->
    <template id="cart_save_favorite" name="Save Cart as a Favorite" inherit_id="website_sale.navigation_buttons">
        <xpath expr="//a[@name='website_sale_main_button']" position="after">
            <t t-if="current_website_checkout_step_href == '/shop/cart' and not website.is_public_user() and request.env.user.int_portal_can('pin_orders')">
                <t t-call="int_sale_customizations.portal_favorite_notice"/>
                <button type="button" class="btn btn-outline-primary w-100 o_int_fav_cart_btn" data-bs-toggle="modal" data-bs-target="#int_fav_cart_modal">
                    <i class="fa fa-star-o me-2" aria-hidden="true"/>Save Cart as a Favorite
                </button>
                <div class="modal fade o_int_fav_modal" id="int_fav_cart_modal" tabindex="-1" aria-labelledby="int_fav_cart_modal_title" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <form class="modal-content" method="post" action="/shop/cart/favorite">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="modal-header">
                                <h2 class="modal-title" id="int_fav_cart_modal_title"><i class="fa fa-star" aria-hidden="true"/> Save Cart to Favorite Orders</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body">
                                <label for="int_fav_cart_name" class="form-label">Name</label>
                                <input id="int_fav_cart_name" name="name" class="form-control" maxlength="120" autocomplete="off" placeholder="For example, Standard 12V van kit"/>
                                <p class="o_int_fav_hint">Saves these products and quantities for everyone at <t t-out="request.env.user.partner_id.commercial_partner_id.name"/>. Your cart stays as it is, so you can still check out now.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment step: pay now for what ships now, on account for dealers on terms. -->
    <template id="payment_backorder_and_terms" inherit_id="website_sale.payment" name="Pay Now and Pay on Account">
        <xpath expr="//div[@name='website_sale_non_free_cart']" position="before">
            <div t-if="int_error" class="alert alert-warning" role="alert" t-out="int_error"/>
            <t t-set="int_currency" t-value="website_sale_order.currency_id"/>
            <div t-if="not errors and int_terms and int_terms['on_terms'] and int_pay_now" class="card mb-3 o_int_on_account">
                <div class="card-body">
                    <h5 class="card-title">Pay on Account</h5>
                    <t t-if="int_terms['eligible']">
                        <p class="mb-2">
                            Place this order on your account. We'll invoice it on your
                            <strong t-out="int_terms['term'].display_name"/> terms.
                        </p>
                        <form action="/shop/int_on_account" method="post" class="o_int_on_account_form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary w-100">Place Order on Account</button>
                        </form>
                        <p class="small text-muted mb-0 mt-2">Or pay by card below.</p>
                    </t>
                    <p t-else="" class="mb-0 text-muted" t-out="int_terms['reason']"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@name='website_sale_non_free_cart']" position="attributes">
            <attribute name="t-if">not errors and website_sale_order._int_pay_now_amount()</attribute>
        </xpath>
        <xpath expr="//div[@name='website_sale_non_free_cart']/following-sibling::h4[1]" position="replace">
            <h4 t-else="" class="mb-3">
                <t t-if="website_sale_order._int_backorder_lines()">Place backorder</t>
                <t t-else="">Confirm order</t>
            </h4>
        </xpath>
    </template>

    <!-- Order summary of a split cart: what is paid today, and what is billed when the backorder ships.
         Odoo's rows stay in the page, hidden, for the checkout script that updates them. -->
    <template id="total_backorder_due_today" inherit_id="website_sale.total" name="Due Today">
        <xpath expr="//div[contains(@t-attf-class, 'o_cart_total')]" position="before">
            <t t-set="int_split_cart" t-value="website_sale_order and website_sale_order.state in ('draft', 'sent') and website_sale_order._int_backorder_lines()"/>
        </xpath>
        <xpath expr="//tr[@name='o_order_delivery']" position="attributes">
            <attribute name="t-att-class">'d-none' if int_split_cart else None</attribute>
        </xpath>
        <xpath expr="//tr[@name='o_order_total_untaxed']" position="attributes">
            <attribute name="t-att-class">'d-none' if int_split_cart else None</attribute>
        </xpath>
        <xpath expr="//tr[@name='o_order_total_taxes']" position="attributes">
            <attribute name="t-att-class">'d-none' if int_split_cart else None</attribute>
        </xpath>
        <xpath expr="//tr[@name='o_order_total']" position="attributes">
            <attribute name="class"/>
            <attribute name="t-att-class">'d-none' if int_split_cart else 'border-top'</attribute>
        </xpath>
        <xpath expr="//tr[@name='o_order_total']" position="after">
            <t t-if="int_split_cart">
                <t t-set="int_sum" t-value="website_sale_order._int_checkout_summary()"/>
                <t t-set="int_money" t-value="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                <t t-set="int_ships_now" t-value="int_sum['now_items'] or int_sum['due_today']"/>
                <tr name="o_int_today_heading">
                    <td colspan="3" class="border-0 px-0 pt-0 pb-2 small text-uppercase fw-semibold text-muted">Paying today</td>
                </tr>
                <tr t-if="int_ships_now" name="o_int_now_items">
                    <td colspan="2" class="border-0 ps-0 pt-0 pb-2 text-muted">Items shipping now</td>
                    <td class="text-end border-0 pe-0 pt-0 pb-2">
                        <span t-out="int_sum['now_items']" style="white-space: nowrap;" t-options="int_money"/>
                    </td>
                </tr>
                <tr t-if="int_ships_now and website_sale_order._has_deliverable_products()" name="o_int_now_shipping">
                    <td colspan="2" class="border-0 ps-0 pt-0 pb-2 text-muted">Shipping</td>
                    <td class="text-end border-0 pe-0 pt-0 pb-2">
                        <t t-if="not website_sale_order.carrier_id">-</t>
                        <t t-elif="website_sale_order.currency_id.is_zero(int_sum['now_shipping'])">Free</t>
                        <span t-else="" t-out="int_sum['now_shipping']" style="white-space: nowrap;" t-options="int_money"/>
                    </td>
                </tr>
                <tr t-if="int_ships_now and not website_sale_order.currency_id.is_zero(int_sum['now_tax'])" name="o_int_now_tax">
                    <td colspan="2" class="border-0 ps-0 pt-0 pb-2 text-muted">Tax</td>
                    <td class="text-end border-0 pe-0 pt-0 pb-2">
                        <span t-out="int_sum['now_tax']" style="white-space: nowrap;" t-options="int_money"/>
                    </td>
                </tr>
                <tr name="o_int_order_due_today" class="border-top">
                    <td colspan="2" class="border-0 ps-0 pt-2 pb-3"><strong>Due Today</strong></td>
                    <td class="text-end border-0 px-0 pt-2 pb-3">
                        <strong class="fs-5" t-out="int_sum['due_today']" style="white-space: nowrap;" t-options="int_money"/>
                    </td>
                </tr>
                <tr name="o_int_order_later">
                    <td colspan="3" class="border-0 px-0 pt-0 pb-3">
                        <div class="o_int_later rounded p-3 bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="border-style: dashed !important;">
                            <div class="small text-uppercase fw-semibold mb-2">Billed when it ships</div>
                            <div class="d-flex justify-content-between gap-2 mb-1">
                                <span>Backordered items (<t t-out="int_sum['later_qty']"/>)</span>
                                <span t-out="int_sum['later_items']" style="white-space: nowrap;" t-options="int_money"/>
                            </div>
                            <div t-if="website_sale_order._has_deliverable_products()" class="d-flex justify-content-between gap-2 mb-1">
                                <span>Shipping</span>
                                <span>TBD</span>
                            </div>
                            <div t-if="not website_sale_order.currency_id.is_zero(int_sum['later_tax'])" class="d-flex justify-content-between gap-2 mb-1">
                                <span>Tax</span>
                                <span t-out="int_sum['later_tax']" style="white-space: nowrap;" t-options="int_money"/>
                            </div>
                            <p class="small mb-0 mt-2">We'll let you know when there's an ETA and bill these items then.</p>
                        </div>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>

    <!-- Checkout on phones: the order summary is shown on the page, under the step's content,
         instead of in a side panel. The bottom bar keeps only the sticky Pay / Continue button.
         Odoo's checkout script updates the summary card on its own, so it doesn't need the panel. -->
    <template id="checkout_layout_due_today" inherit_id="website_sale.checkout_layout" name="Order Summary on Phones">
        <xpath expr="//div[hasclass('o_total_card')]/.." position="attributes">
            <attribute name="class">offset-xxl-1 col-12 col-lg-5 col-xxl-4 rounded mt-3 mt-lg-0</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_total_card')]/div[hasclass('card-body')]/div[1]" position="attributes">
            <attribute name="class">o_int_summary_body</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_total_card')]//div[hasclass('o_cta_navigation_container')]" position="attributes">
            <attribute name="class">o_cta_navigation_container px-0 d-none d-lg-block</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_mobile_summary')]/button" position="replace"/>
        <xpath expr="//div[@id='o_cart_summary_offcanvas']" position="replace"/>
        <xpath expr="//div[hasclass('o_mobile_summary')]" position="attributes">
            <attribute name="class">o_mobile_summary d-lg-none sticky-bottom mt-auto bg-body border-top pt-2</attribute>
        </xpath>
    </template>

    <!-- Thank-you page: a payment for the ship-now part is a full payment. -->
    <template id="payment_confirmation_status_backorder" inherit_id="website_sale.payment_confirmation_status" name="Backorder Payment Status">
        <xpath expr="//div[@t-if='tx_sudo']" position="attributes">
            <attribute name="t-attf-class">alert px-3 pb-0 pt-3 #{
                    (tx_sudo.state == 'pending' and 'alert-info') or
                    (tx_sudo.state == 'done' and order._int_payment_matches(tx_sudo) and 'alert-success') or
                    (tx_sudo.state == 'done' and 'alert-warning') or
                    (tx_sudo.state == 'authorized' and 'alert-success') or
                    'alert-danger'}</attribute>
        </xpath>
        <xpath expr="//t[contains(@t-if, 'order.amount_total != tx_sudo.amount')]" position="attributes">
            <attribute name="t-if">tx_sudo.state == 'done' and not order._int_payment_matches(tx_sudo)</attribute>
        </xpath>
    </template>

    <!-- An all-backorder cart uses Odoo's free-cart button, relabelled. -->
    <template id="navigation_buttons_backorder" inherit_id="website_sale.navigation_buttons" name="Place Backorder Button">
        <xpath expr="//div[@name='o_website_sale_free_cart']" position="attributes">
            <attribute name="t-if">not errors and not website_sale_order._int_pay_now_amount()</attribute>
        </xpath>
        <xpath expr="//div[@name='o_website_sale_free_cart']//t[@t-set='submit_button_label']" position="replace">
            <t t-set="submit_button_label"><t t-if="website_sale_order._int_backorder_lines()">Place Backorder</t><t t-else="">Confirm Order</t></t>
        </xpath>
    </template>

    <template id="confirmation_backorder_and_terms" inherit_id="website_sale.confirmation" name="Backorder and Account Notes">
        <xpath expr="//div[@id='order_name']/preceding-sibling::div[1]" position="attributes">
            <attribute name="t-if">tx_sudo.state in ['pending', 'done'] or not order.amount_total or (order.state == 'sale' and not tx_sudo)</attribute>
        </xpath>
        <xpath expr="//div[@id='order_name']" position="after">
            <div t-if="order.int_on_account" class="alert alert-info" role="status">
                Placed on your account. We'll invoice you on your
                <t t-out="order.payment_term_id.display_name or 'payment'"/> terms.
            </div>
            <div t-if="order.order_line.filtered('int_backorder')" class="alert alert-warning" role="status">
                Some items are on backorder, with no ETA yet. You haven't been charged for them.
                We'll invoice you once they arrive at our warehouse, before they ship.
            </div>
        </xpath>
    </template>

    <!-- Order page: backorder notice and Cancel Backordered Items. -->
    <template id="portal_order_backorder" inherit_id="sale.sale_order_portal_content" name="Backordered items">
        <xpath expr="//div[@id='introduction']" position="after">
            <t t-set="int_backorder_lines" t-value="sale_order._int_cancellable_backorder_lines() if sale_order.state == 'sale' else sale_order.order_line.browse()"/>
            <div t-if="int_backorder_lines" class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="status">
                <span>
                    <t t-out="', '.join(int_backorder_lines.product_id.mapped('display_name'))"/>
                    <t t-if="len(int_backorder_lines) == 1"> is</t><t t-else=""> are</t>
                    on backorder, with no ETA yet. We'll invoice
                    <t t-if="len(int_backorder_lines) == 1">it</t><t t-else="">them</t>
                    once the stock arrives, before shipping.
                </span>
                <button t-if="report_type != 'pdf' and sale_order._int_can_cancel_backorder(request.env.user)"
                        type="button" class="btn btn-link btn-sm p-0 ms-md-auto"
                        data-bs-toggle="modal" data-bs-target="#int_cancel_backorder_modal">Cancel Backordered Items</button>
            </div>
            <div t-if="report_type != 'pdf' and int_backorder_lines and sale_order._int_can_cancel_backorder(request.env.user)"
                 class="modal fade" id="int_cancel_backorder_modal" tabindex="-1"
                 aria-labelledby="int_cancel_backorder_title" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form t-attf-action="/my/orders/{{ sale_order.id }}/cancel-backorder" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="modal-header">
                                <h5 class="modal-title" id="int_cancel_backorder_title">Cancel Backordered Items</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body">
                                <p>This cancels only the backordered items. Everything else on the order stays as it is.</p>
                                <ul class="mb-3">
                                    <li t-foreach="int_backorder_lines" t-as="int_line">
                                        <t t-out="int_line.product_id.display_name"/> ×
                                        <t t-out="int_line.product_id.product_tmpl_id._int_format_qty(int_line.product_uom_qty)"/>
                                    </li>
                                </ul>
                                <label class="col-form-label" for="int_cancel_backorder_reason">Reason</label>
                                <select class="form-select mb-2" name="reason" id="int_cancel_backorder_reason" required="required">
                                    <option value="no_longer_needed">No longer needed</option>
                                    <option value="ordered_wrong_item">Ordered the wrong item</option>
                                    <option value="found_elsewhere">Found it elsewhere</option>
                                    <option value="delay">Delay</option>
                                    <option value="other">Other</option>
                                </select>
                                <label class="col-form-label" for="int_cancel_backorder_note">Note</label>
                                <textarea class="form-control" name="note" id="int_cancel_backorder_note"/>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Keep Them</button>
                                <button class="btn btn-primary" type="submit">Cancel Backordered Items</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div t-if="request.params.get('int_backorder') == 'cancelled'" class="alert alert-success" role="status">
                The backordered items are cancelled.
            </div>
        </xpath>
    </template>
</odoo>

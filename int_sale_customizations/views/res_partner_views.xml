<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_quote_basis" model="ir.ui.view">
        <field name="name">res.partner.form.quote.basis</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']/field[@name='user_id']" position="after">
                <field name="int_quote_price_basis" invisible="parent_id"/>
            </xpath>
        </field>
    </record>
</odoo>

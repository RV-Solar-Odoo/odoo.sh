<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal logins have no access row, so they cannot read these models directly.
         The website uses sudo after create_quotes and the dealer domain. Staff stay
         inside their companies. -->
    <record id="rule_int_dealer_quote_portal" model="ir.rule">
        <field name="name">Customer quotes: own dealer</field>
        <field name="model_id" ref="model_int_dealer_quote"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('partner_id', '=', user.partner_id.commercial_partner_id.id)] if not user.has_group('base.group_user') else [('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_int_dealer_quote_line_portal" model="ir.rule">
        <field name="name">Customer quote lines: own dealer</field>
        <field name="model_id" ref="model_int_dealer_quote_line"/>
        <field name="domain_force">['&amp;', ('quote_id.company_id', 'in', company_ids), ('quote_id.partner_id', '=', user.partner_id.commercial_partner_id.id)] if not user.has_group('base.group_user') else [('quote_id.company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>

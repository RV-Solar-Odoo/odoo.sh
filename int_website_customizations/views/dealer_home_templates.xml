<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Home page, approved dealers only: a dealer support section in place of the
         "become a dealer" section (hidden by dealer_home.scss). Same snippet, grid
         and styling as that section, so it looks native. -->
    <template id="layout_dealer_support" inherit_id="website.layout" name="Dealer support section">
        <xpath expr="//main" position="inside">
            <t t-if="website and main_object and main_object._name == 'website.page' and main_object.url == '/' and request.env['product.template'].sudo()._int_is_dealer_contact(request.env.user.partner_id, website)">
                <section class="s_faq_list o_colored_level bg-black pt64 pb48 o_int_dealer_support">
                    <div class="container">
                        <div class="row o_grid_mode" data-row-count="6">
                            <div class="o_grid_item o_colored_level g-col-lg-5 g-height-6 col-lg-5" style="z-index: 7; grid-area: 1 / 8 / 7 / 13;">
                                <p class="small" style="text-align: left;"><span style="font-size: 16px;">Start a return on a past order</span></p>
                                <p class="small" style="text-align: left;"><span style="font-size: 16px;">File a warranty claim with photos and serial numbers</span></p>
                                <p class="small" style="text-align: left;"><span style="font-size: 16px;">Request a part we don't stock</span></p>
                                <p class="small" style="text-align: left;"><span style="font-size: 16px;">Tell us about website, shipping or billing issues</span></p>
                                <p class="small" style="text-align: left;"><span style="font-size: 16px;">Reach your sales rep directly</span></p>
                            </div>
                            <div class="o_grid_item o_colored_level g-col-lg-5 g-height-3 col-lg-5" style="z-index: 1; grid-area: 1 / 2 / 4 / 7;">
                                <p><span style="font-size: 26px;">Your Dealer Support Center</span></p>
                                <p><span style="font-size: 16px;">Returns, warranty claims, special orders and feedback, all in one place.</span></p>
                            </div>
                            <div class="o_grid_item o_colored_level g-col-lg-2 g-height-1 col-lg-2" style="z-index: 8; grid-area: 4 / 2 / 5 / 4;">
                                <p><a class="btn btn-fill-custom" href="/my/help" style="color: rgb(255, 255, 255); background-color: rgb(0, 84, 168); border-width: 1px; border-color: rgb(0, 84, 168); border-style: solid;">Help &amp; Feedback</a></p>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- My Account > Payment methods: saved cards as a list with an "Add a payment method"
         button, like the Help & Feedback returns page. Stock's payment form still does the
         saving and deleting; only its layout changes, and only on this page. -->
    <template id="portal_payment_methods_page" inherit_id="payment.payment_methods"
              name="Payment methods: list and add button">
        <xpath expr="//t[@t-call='payment.form']" position="replace">
            <div class="o_int_paymethods">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 my-3">
                    <h3 class="my-0">Payment methods</h3>
                    <button t-if="payment_methods_sudo and tokens_sudo" type="button" class="btn btn-primary"
                            data-bs-toggle="modal" data-bs-target="#o_int_add_payment_method">
                        Add a payment method
                    </button>
                </div>
                <div t-if="not tokens_sudo" class="o_int_paymethods_empty">
                    <p class="mb-3">You don't have any payment methods saved yet. Add a card now to check out faster.</p>
                    <button t-if="payment_methods_sudo" type="button" class="btn btn-primary"
                            data-bs-toggle="modal" data-bs-target="#o_int_add_payment_method">
                        Add a payment method
                    </button>
                </div>
                <t t-call="payment.form">
                    <t t-set="int_payment_methods_page" t-value="True"/>
                    <t t-set="display_submit_button" t-value="False"/>
                </t>
            </div>
        </xpath>
    </template>

    <!-- On that page only, the "add" part of the form opens in a pop-up. It stays inside the
         <form>, so stock's script still finds the card fields and the Save button. -->
    <template id="payment_form_add_in_modal" inherit_id="payment.form"
              name="Payment methods: add a card in a pop-up">
        <xpath expr="//div[@id='o_payment_methods']" position="replace">
            <t t-if="int_payment_methods_page">
                <div class="modal fade" id="o_int_add_payment_method" tabindex="-1"
                     aria-labelledby="o_int_add_payment_method_title" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="o_int_add_payment_method_title">Add a payment method</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body"><t>$0</t></div>
                            <div class="modal-footer">
                                <t t-call="payment.submit_button"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else=""><t>$0</t></t>
        </xpath>
    </template>
</odoo>

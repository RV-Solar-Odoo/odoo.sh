<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approved dealers only. The links use the same header menu as Home / Shop / About. -->
    <template id="dealer_nav" inherit_id="website.navbar_nav" name="Dealer portal menu">
        <xpath expr="//t[@t-out='0']" position="replace">
            <t t-if="website and not request.env.user._is_public() and request.env['product.template']._int_is_dealer_contact(request.env.user.partner_id, website)">
                <t t-set="int_user" t-value="request.env.user"/>
                <t t-set="int_path" t-value="request.httprequest.path or ''"/>
                <t t-set="int_orders_here" t-value="int_path.startswith('/shop') or int_path.startswith('/my/orders') or int_path.startswith('/my/invoices') or int_path.startswith('/my/deliveries') or int_path.startswith('/my/po-upload')"/>
                <li class="nav-item dropdown" role="presentation">
                    <a href="#" t-attf-class="nav-link dropdown-toggle #{int_orders_here and 'active' or ''}" data-bs-toggle="dropdown" role="menuitem" aria-expanded="false">Orders</a>
                    <ul t-attf-class="dropdown-menu #{is_vertical_nav and 'position-relative rounded-0' or ''}" role="menu">
                        <li t-if="int_user.int_portal_can('place_orders')" role="presentation">
                            <a class="dropdown-item" href="/shop" role="menuitem">Shop</a>
                        </li>
                        <li t-if="int_user.int_portal_can('view_orders')" role="presentation">
                            <a class="dropdown-item" href="/my/orders?filterby=saved" role="menuitem">Saved Orders</a>
                        </li>
                        <li t-if="int_user.int_portal_can('view_orders')" role="presentation">
                            <a class="dropdown-item" href="/my/orders" role="menuitem">Sales Orders</a>
                        </li>
                        <li t-if="int_user.int_portal_can('view_invoices')" role="presentation">
                            <a class="dropdown-item" href="/my/invoices" role="menuitem">Invoices</a>
                        </li>
                        <li t-if="int_user.int_portal_can('view_orders')" role="presentation">
                            <a class="dropdown-item" href="/my/deliveries" role="menuitem">Deliveries</a>
                        </li>
                        <li t-if="int_user.int_portal_can('upload_po')" role="presentation">
                            <a class="dropdown-item" href="/my/po-upload" role="menuitem">Upload a PO</a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item" role="presentation">
                    <a t-attf-class="nav-link #{int_path.startswith('/help') and 'active' or ''}" href="/help" role="menuitem">Support</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a t-attf-class="nav-link #{int_path.startswith('/my/address') and 'active' or ''}" href="/my/addresses" role="menuitem">Addresses</a>
                </li>
            </t>
            <t t-else="" t-out="0"/>
        </xpath>
    </template>
</odoo>

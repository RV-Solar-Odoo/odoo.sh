<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every product search box renders through here: shop header, mobile modal,
         filter panel and product page. The autocomplete reads its category from the
         action too, so this makes it search all products as well. -->
    <template id="product_search_always_global" inherit_id="website.website_search_box_input"
              name="Product search covers the whole shop">
        <xpath expr="//form" position="before">
            <t t-if="search_type == 'products'">
                <t t-set="action" t-valuef="/shop"/>
                <t t-set="placeholder">Search products</t>
            </t>
        </xpath>
    </template>

    <template id="product_price_breakdown" inherit_id="website_sale.product_price"
              name="Dealer MSRP, MAP, and dealer price" active="True">
        <xpath expr="//div[@name='product_price_container']" position="replace">
            <div name="product_price_container"
                 t-if="not combination_info.get('int_is_dealer')"
                 class="css_editable_mode_hidden d-flex align-items-baseline justify-content-start gap-2 flex-wrap h5 mb-0 text-wrap">
                <span t-if="combination_info.get('int_price_text')"
                      class="oe_price o_int_retail_map"
                      style="white-space: nowrap;"
                      t-out="combination_info['int_price_text']"/>
                <span t-else=""
                      class="oe_price"
                      style="white-space: nowrap;"
                      t-out="combination_info['price']"
                      t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <span t-if="combination_info.get('has_discounted_price') and combination_info.get('int_list_text')"
                      style="text-decoration: line-through; white-space: nowrap;"
                      name="product_list_price"
                      class="text-muted oe_default_price mb-0 h5"
                      t-out="combination_info['int_list_text']"/>
                <span t-elif="combination_info.get('has_discounted_price')"
                      style="text-decoration: line-through; white-space: nowrap;"
                      name="product_list_price"
                      class="text-muted oe_default_price mb-0 h5"
                      t-out="combination_info['list_price']"
                      t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='product_price_container']" position="after">
            <div t-if="combination_info.get('int_is_dealer')"
                 class="o_int_price_breakdown h5 mb-0 text-start">
                <table>
                    <tr>
                        <td class="text-muted">MSRP</td>
                        <td class="text-end"
                            t-out="combination_info['int_msrp']"
                            t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    </tr>
                    <tr>
                        <td class="text-muted">MAP</td>
                        <td class="text-end"
                            t-out="combination_info['int_map_price']"
                            t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    </tr>
                    <tr class="o_int_dealer_price">
                        <td class="fw-semibold">Dealer</td>
                        <td class="text-end fw-semibold"
                            t-out="combination_info['int_dealer_price']"
                            t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>

    <record id="product_price_breakdown" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>
</odoo>

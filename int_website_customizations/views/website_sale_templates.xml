<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every product search box renders through here: shop header, mobile modal,
         filter panel and product page. The autocomplete reads its category from the
         action too, so this makes it search all products as well. -->
    <template id="product_search_always_global" inherit_id="website.website_search_box_input"
              name="Product search covers the whole shop">
        <xpath expr="//form" position="before">
            <t t-if="search_type == 'products'">
                <t t-set="action" t-valuef="/shop"/>
                <t t-set="placeholder">Search products</t>
            </t>
        </xpath>
    </template>

    <template id="product_price_breakdown" inherit_id="website_sale.product_price"
              name="MSRP, MAP, and dealer price">
        <xpath expr="//div[@name='product_price_container']" position="after">
            <div t-if="combination_info.get('int_show_price_breakdown')"
                 class="o_int_price_breakdown small mt-2 text-end">
                <div class="d-flex justify-content-end gap-3">
                    <span class="text-muted">MSRP</span>
                    <span t-out="combination_info['int_msrp']"
                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                </div>
                <div class="d-flex justify-content-end gap-3">
                    <span class="text-muted">MAP</span>
                    <span t-out="combination_info['int_map_price']"
                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                </div>
                <div t-if="combination_info.get('int_is_dealer')"
                     class="d-flex justify-content-end gap-3 fw-semibold">
                    <span>Dealer</span>
                    <span t-out="combination_info['int_dealer_price']"
                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>

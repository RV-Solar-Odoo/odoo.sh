<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_position_form_nexus" model="ir.ui.view">
        <field name="name">account.fiscal.position.form.nexus</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="int_nexus_resale"/>
            </field>
        </field>
    </record>

    <record id="view_tax_form_nexus" model="ir.ui.view">
        <field name="name">account.tax.form.nexus</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="type_tax_use" position="after">
                <field name="int_nexus_treatment"/>
            </field>
        </field>
    </record>

    <record id="view_order_form_nexus" model="ir.ui.view">
        <field name="name">sale.order.form.nexus</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="client_order_ref" position="after">
                <field name="int_marketplace_collected"/>
            </field>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.int.account.nexus</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="fiscal_localization_setting_container" position="after">
                <block title="Sales tax thresholds" name="int_nexus_alert">
                    <setting
                        string="Email when a state crosses a threshold"
                        help="Checked on the 1st of each month. One email lists every state that crossed its dollar amount or its transaction count."
                    >
                        <field name="int_nexus_alert_user_id"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>

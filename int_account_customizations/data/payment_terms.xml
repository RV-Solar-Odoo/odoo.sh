<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Dealer terms set by Create Dealer Account. Due on the 10th of the month after the
         invoice date. Admins can change a dealer's terms on the contact's Sales & Purchase tab. -->
    <record id="payment_term_net_10th" model="account.payment.term">
        <field name="name">Net 10th</field>
        <field name="note">Payment is due on the 10th of the month after the invoice date.</field>
        <field name="line_ids" eval="[Command.clear(), Command.create({
            'value': 'percent',
            'value_amount': 100.0,
            'delay_type': 'days_end_of_month_on_the',
            'nb_days': 0,
            'days_next_month': '10',
        })]"/>
    </record>
</odoo>

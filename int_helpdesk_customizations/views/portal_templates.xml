<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_help" name="My Portal Help &amp; Feedback" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='portal_common_category']" position="before">
            <div t-if="request.params.get('int_help_warning')" class="o_portal_index_card col-12">
                <div class="alert alert-warning mb-0" role="alert">
                    Help &amp; Feedback is not available for this account.
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@id='portal_service_category']" position="inside">
            <t t-if="request.env.user._int_help_hub_visible()" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/int_helpdesk_customizations/static/src/img/help_feedback.png?v=4'"/>
                <t t-set="title">Help &amp; Feedback</t>
                <t t-set="text">Returns, warranty, feedback, and part requests</t>
                <t t-set="url" t-value="'/my/help'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_help_breadcrumbs" name="Help &amp; Feedback breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'int_help'" class="breadcrumb-item">Help &amp; Feedback</li>
            <li t-if="page_name in ('int_help_form', 'int_help_done', 'int_help_returns')" class="breadcrumb-item">
                <a href="/my/help">Help &amp; Feedback</a>
            </li>
            <li t-if="page_name == 'int_help_returns'" class="breadcrumb-item">Returns</li>
            <li t-if="page_name == 'int_help_form' and kind == 'return'" class="breadcrumb-item">
                <a href="/my/help/return">Returns</a>
            </li>
            <li t-if="page_name == 'int_help_form'" class="breadcrumb-item" t-out="int_help_title"/>
            <li t-if="page_name == 'int_help_done'" class="breadcrumb-item">Request received</li>
        </xpath>
    </template>

    <template id="portal_help_hub" name="Help &amp; Feedback hub">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'int_help'"/>
            <t t-set="additional_title">Help &amp; Feedback</t>
            <div class="o_int_help_hub">
                <h3 class="my-3">Help &amp; Feedback</h3>
                <div class="o_int_help_hub_grid">
                    <a t-if="request.env.user._int_help_kind_allowed('return')" class="o_int_help_hub_card" href="/my/help/return">
                        <span class="o_int_help_hub_icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                        </span>
                        <h2>Returns</h2>
                        <p>Start a return for unused or incorrect items, or check on one you've already sent.</p>
                        <span class="o_int_help_hub_cta">Start or view returns <i class="oi oi-arrow-right"/></span>
                    </a>
                    <a t-if="request.env.user._int_help_kind_allowed('warranty')" class="o_int_help_hub_card" href="/my/help/warranty">
                        <span class="o_int_help_hub_icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                        </span>
                        <h2>Start a warranty claim</h2>
                        <p>Report a product that has failed. Include the serial number and photos so we can process it quickly.</p>
                        <span class="o_int_help_hub_cta">Start a claim <i class="oi oi-arrow-right"/></span>
                    </a>
                    <a t-if="request.env.user._int_help_kind_allowed('feedback')" class="o_int_help_hub_card" href="/my/help/feedback">
                        <span class="o_int_help_hub_icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8"/><path d="M8 13h5"/></svg>
                        </span>
                        <h2>Website &amp; operations feedback</h2>
                        <p>Something broken, confusing or slow — on the site, in shipping, billing or anything else? Tell us and we'll fix it.</p>
                        <span class="o_int_help_hub_cta">Send feedback <i class="oi oi-arrow-right"/></span>
                    </a>
                    <a t-if="request.env.user._int_help_kind_allowed('part')" class="o_int_help_hub_card" href="/my/help/part">
                        <span class="o_int_help_hub_icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05"/><path d="M12 22.08V12"/></svg>
                        </span>
                        <h2>Request a part we don't stock</h2>
                        <p>Need something we don't carry? Tell us what it is and roughly how many you use per year.</p>
                        <span class="o_int_help_hub_cta">Request a part <i class="oi oi-arrow-right"/></span>
                    </a>
                </div>
                <div class="o_int_help_rep">
                    <t t-call="int_contacts_customizations.portal_sales_rep_card"/>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_help_returns" name="Help &amp; Feedback returns">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'int_help_returns'"/>
            <t t-set="additional_title">Returns</t>
            <div class="o_int_help_hub">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 my-3">
                    <h3 class="my-0">Your returns</h3>
                    <a href="/my/help/return/new" class="btn btn-primary">Start a new return</a>
                </div>
                <div t-if="tickets" class="o_int_help_returns">
                    <a t-foreach="tickets" t-as="ticket" class="o_int_help_return_row" t-att-href="ticket.get_portal_url()">
                        <span class="o_int_help_return_main">
                            <span class="o_int_help_return_name" t-out="ticket.name"/>
                            <span class="o_int_help_return_meta">
                                #<t t-out="ticket._int_help_reference(ticket)"/> · opened
                                <t t-out="ticket.create_date" t-options="{'widget': 'date'}"/>
                            </span>
                        </span>
                        <span class="o_int_help_return_stage" t-out="ticket.stage_id.name"/>
                    </a>
                </div>
                <p t-else="" class="o_int_help_returns_empty">No open returns.</p>
            </div>
        </t>
    </template>

    <template id="portal_help_form" name="Help &amp; Feedback form">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'int_help_form'"/>
            <t t-set="additional_title" t-value="title"/>
            <t t-set="int_help_title" t-value="title"/>
            <t t-set="values" t-value="values or {}"/>
            <div class="o_int_help_card">
                <h3 class="mb-3" t-out="title"/>
                <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                <p t-if="notice" class="mb-0" t-out="notice"/>
                <form t-if="not notice" t-att-action="'/my/help/return/new' if kind == 'return' else '/my/help/%s' % kind" method="post" enctype="multipart/form-data" class="o_int_help_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div t-if="kind == 'return'" class="o_int_help_note mb-3">
                        Returns are for items that work but aren't needed or were ordered by mistake.
                        Product not working? <a href="/my/help/warranty">Start a warranty claim instead.</a>
                    </div>

                    <!-- Retail only: where the product was bought. Dealers are not asked. -->
                    <t t-if="ask_purchase">
                        <fieldset class="mb-3 js-int-help-purchase">
                            <legend class="form-label fs-6">Where did you buy it?<span class="text-danger">*</span></legend>
                            <t t-foreach="purchase_sources" t-as="source">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="purchase_source" required="required"
                                           t-attf-id="int_help_purchase_#{source[0]}" t-att-value="source[0]"
                                           t-att-checked="(values.get('purchase_source') or '') == source[0] and 'checked' or None"/>
                                    <label class="form-check-label" t-attf-for="int_help_purchase_#{source[0]}" t-out="source[1]"/>
                                </div>
                            </t>
                        </fieldset>
                        <div t-attf-class="mb-3 js-int-help-dealer #{'' if values.get('purchase_source') == 'dealer' else 'd-none'}">
                            <label class="form-label" for="int_help_purchase_dealer">Which dealer?<span class="text-danger">*</span></label>
                            <select id="int_help_purchase_dealer" name="purchase_dealer_id" class="form-select"
                                    t-att-required="values.get('purchase_source') == 'dealer' and 'required' or None">
                                <option value="">Select a dealer</option>
                                <t t-foreach="dealers" t-as="dealer">
                                    <option t-att-value="dealer.id" t-att-selected="(values.get('purchase_dealer_id') or '') == str(dealer.id) and 'selected' or None" t-out="dealer.name"/>
                                </t>
                            </select>
                        </div>
                    </t>

                    <t t-if="kind == 'return'">
                        <!-- No orders on the account, or "My order isn't listed": type them instead. -->
                        <t t-set="int_typed" t-value="not orders or values.get('order_id') == typed_order"/>
                        <div t-if="orders" class="mb-3">
                            <label class="form-label" for="int_help_order">Order<span class="text-danger">*</span></label>
                            <select id="int_help_order" name="order_id" class="form-select js-int-help-order" required="required" t-att-data-typed="typed_order">
                                <option value="">Select an order</option>
                                <t t-foreach="orders" t-as="order">
                                    <option t-att-value="order.id" t-att-selected="(values.get('order_id') or '') == str(order.id) and 'selected' or None" t-out="order.name"/>
                                </t>
                                <option t-att-value="typed_order" t-att-selected="int_typed and 'selected' or None">My order isn't listed</option>
                            </select>
                        </div>
                        <input t-else="" type="hidden" name="order_id" t-att-value="typed_order"/>
                        <div t-attf-class="mb-3 js-int-help-picked #{'d-none' if int_typed else ''}">
                            <label class="form-label" for="int_help_product">Product / SKU<span class="text-danger">*</span></label>
                            <select id="int_help_product" name="product_id" class="form-select js-int-help-product" t-att-required="not int_typed and 'required' or None" t-att-data-selected="values.get('product_id') or ''">
                                <option value="">Select a product</option>
                            </select>
                        </div>
                        <div t-attf-class="js-int-help-typed #{'' if int_typed else 'd-none'}">
                            <p t-if="not orders" class="form-text mt-0 mb-3">
                                We couldn't find any orders on your account. Type the order number and product instead.
                            </p>
                            <div class="mb-3">
                                <label class="form-label" for="int_help_order_ref">Order number<span class="text-danger">*</span></label>
                                <input id="int_help_order_ref" type="text" name="order_ref" class="form-control" t-att-required="int_typed and 'required' or None" t-att-value="values.get('order_ref') or ''"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="int_help_return_product">Product / SKU<span class="text-danger">*</span></label>
                                <input id="int_help_return_product" type="text" name="product_text" class="form-control" t-att-required="int_typed and 'required' or None" t-att-value="values.get('product_text') or ''"/>
                            </div>
                        </div>
                    </t>

                    <t t-if="kind == 'warranty'">
                        <div class="mb-3">
                            <label class="form-label" for="int_help_order">Order</label>
                            <select id="int_help_order" name="order_id" class="form-select js-int-help-order">
                                <option value="">Select an order</option>
                                <t t-foreach="orders" t-as="order">
                                    <option t-att-value="order.id" t-att-selected="(values.get('order_id') or '') == str(order.id) and 'selected' or None" t-out="order.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_product">Product from this order</label>
                            <select id="int_help_product" name="product_id" class="form-select js-int-help-product" t-att-data-selected="values.get('product_id') or ''">
                                <option value="">Select a product</option>
                            </select>
                        </div>
                    </t>

                    <div t-if="kind == 'warranty'" class="mb-3">
                        <label class="form-label" for="int_help_product_text">Product / SKU<span class="text-danger">*</span></label>
                        <input id="int_help_product_text" type="text" name="product_text" class="form-control" required="required" t-att-value="values.get('product_text') or ''"/>
                    </div>

                    <!-- Filled from the order's delivered serials: one is prefilled, several
                         become a dropdown, none leaves the text box. -->
                    <div t-if="kind in ('return', 'warranty')" class="mb-3 js-int-help-serial">
                        <label class="form-label" for="int_help_serial">Serial number<t t-if="kind == 'warranty'"><span class="text-danger">*</span></t></label>
                        <input id="int_help_serial" type="text" name="serial" class="form-control js-int-help-serial-text" t-att-required="kind == 'warranty' and 'required' or None" t-att-value="values.get('serial') or ''"/>
                        <select name="serial" class="form-select d-none js-int-help-serial-pick" disabled="disabled" t-att-required="kind == 'warranty' and 'required' or None" aria-label="Serial number"/>
                    </div>

                    <div t-if="kind == 'return'" class="mb-3">
                        <label class="form-label" for="int_help_quantity">Quantity<span class="text-danger">*</span></label>
                        <input id="int_help_quantity" type="number" name="quantity" class="form-control" required="required" min="0.01" step="any" t-att-value="values.get('quantity') or ''"/>
                    </div>

                    <!-- Same questions as the public returns form. -->
                    <t t-if="kind == 'return'">
                        <div class="mb-3">
                            <label class="form-label" for="int_help_reason">Reason for return<span class="text-danger">*</span></label>
                            <select id="int_help_reason" name="reason" class="form-select js-int-help-other" data-other="#int_help_reason_other_wrap" required="required">
                                <option value="">Select a reason</option>
                                <t t-foreach="reasons" t-as="reason">
                                    <option t-att-value="reason[0]" t-att-selected="(values.get('reason') or '') == reason[0] and 'selected' or None" t-out="reason[1]"/>
                                </t>
                            </select>
                        </div>
                        <div id="int_help_reason_other_wrap" t-attf-class="mb-3 #{'' if values.get('reason') == 'other' else 'd-none'}">
                            <label class="form-label" for="int_help_reason_other">Other</label>
                            <input id="int_help_reason_other" type="text" name="reason_other" class="form-control" t-att-value="values.get('reason_other') or ''"/>
                        </div>
                        <fieldset class="mb-3">
                            <legend class="form-label fs-6">Is the product in its original packaging?<span class="text-danger">*</span></legend>
                            <t t-foreach="packaging" t-as="option">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="packaging" required="required"
                                           t-attf-id="int_help_packaging_#{option[0]}" t-att-value="option[0]"
                                           t-att-checked="(values.get('packaging') or '') == option[0] and 'checked' or None"/>
                                    <label class="form-check-label" t-attf-for="int_help_packaging_#{option[0]}" t-out="option[1]"/>
                                </div>
                            </t>
                        </fieldset>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_condition">Product condition<span class="text-danger">*</span></label>
                            <select id="int_help_condition" name="condition" class="form-select" required="required">
                                <option value="">Select a condition</option>
                                <t t-foreach="conditions" t-as="option">
                                    <option t-att-value="option[0]" t-att-selected="(values.get('condition') or '') == option[0] and 'selected' or None" t-out="option[1]"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_outcome">Desired outcome</label>
                            <select id="int_help_outcome" name="outcome" class="form-select js-int-help-other" data-other="#int_help_outcome_other_wrap">
                                <option value="">Select an outcome</option>
                                <t t-foreach="outcomes" t-as="option">
                                    <option t-att-value="option[0]" t-att-selected="(values.get('outcome') or '') == option[0] and 'selected' or None" t-out="option[1]"/>
                                </t>
                            </select>
                        </div>
                        <div id="int_help_outcome_other_wrap" t-attf-class="mb-3 #{'' if values.get('outcome') == 'other' else 'd-none'}">
                            <label class="form-label" for="int_help_outcome_other">Other</label>
                            <input id="int_help_outcome_other" type="text" name="outcome_other" class="form-control" t-att-value="values.get('outcome_other') or ''"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_details">Additional information</label>
                            <textarea id="int_help_details" name="details" class="form-control" rows="4"><t t-out="values.get('details') or ''"/></textarea>
                        </div>
                    </t>

                    <div t-if="kind == 'warranty'" class="mb-3">
                        <label class="form-label" for="int_help_install">Install date<span class="text-danger">*</span></label>
                        <input id="int_help_install" type="date" name="install_date" class="form-control" required="required" t-att-value="values.get('install_date') or ''"/>
                    </div>

                    <div t-if="kind == 'warranty'" class="mb-3">
                        <label class="form-label" for="int_help_failure">Description of failure<span class="text-danger">*</span></label>
                        <textarea id="int_help_failure" name="failure" class="form-control" rows="4" required="required"><t t-out="values.get('failure') or ''"/></textarea>
                    </div>

                    <t t-if="kind == 'feedback'">
                        <div class="mb-3">
                            <label class="form-label" for="int_help_area">Area<span class="text-danger">*</span></label>
                            <select id="int_help_area" name="area" class="form-select" required="required">
                                <option value="">Select an area</option>
                                <t t-foreach="areas" t-as="area">
                                    <option t-att-value="area[0]" t-att-selected="(values.get('area') or '') == area[0] and 'selected' or None" t-out="area[1]"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_description">Description<span class="text-danger">*</span></label>
                            <textarea id="int_help_description" name="description" class="form-control" rows="4" required="required"><t t-out="values.get('description') or ''"/></textarea>
                        </div>
                    </t>

                    <t t-if="kind == 'part'">
                        <div class="mb-3">
                            <label class="form-label" for="int_help_manufacturer">Manufacturer</label>
                            <input id="int_help_manufacturer" type="text" name="manufacturer" class="form-control" t-att-value="values.get('manufacturer') or ''"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_part">Part number or description<span class="text-danger">*</span></label>
                            <textarea id="int_help_part" name="part" class="form-control" rows="3" required="required"><t t-out="values.get('part') or ''"/></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_qty_year">Estimated quantity per year</label>
                            <input id="int_help_qty_year" type="number" name="qty_per_year" class="form-control" min="0" step="any" t-att-value="values.get('qty_per_year') or ''"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_link">Link</label>
                            <input id="int_help_link" type="url" name="link" class="form-control" placeholder="https://" t-att-value="values.get('link') or ''"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_comments">Comments</label>
                            <textarea id="int_help_comments" name="comments" class="form-control" rows="3" placeholder="Tell us why you need it or how you'd use it"><t t-out="values.get('comments') or ''"/></textarea>
                        </div>
                    </t>

                    <div t-if="max_files" class="mb-3">
                        <label class="form-label" for="int_help_files" t-out="upload_label"/>
                        <input id="int_help_files" type="file" name="attachments" class="form-control" t-att-accept="accept" multiple="multiple"/>
                        <div class="form-text">
                            Up to <t t-out="max_files"/> files, 20 MB each.
                            <t t-if="kind == 'warranty'">Images, MP4, or MOV.</t>
                            <t t-else="">JPG, PNG, GIF, or WebP.</t>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>
        </t>
    </template>

    <template id="portal_help_done" name="Help &amp; Feedback confirmation">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'int_help_done'"/>
            <t t-set="additional_title">Request received</t>
            <div class="o_int_help_card">
                <h3 class="mb-3">Request received</h3>
                <p>Your request number is <strong t-out="ticket_reference"/>.</p>
                <a t-attf-href="/helpdesk/ticket/{{ ticket_id }}" class="btn btn-primary">View your ticket</a>
            </div>
        </t>
    </template>
</odoo>

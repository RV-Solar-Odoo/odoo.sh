<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_help" name="My Portal Help &amp; Feedback" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[@id='portal_common_category']" position="before">
            <div t-if="request.params.get('int_help_warning')" class="col-12">
                <div class="alert alert-warning mb-0" role="alert">
                    Help &amp; Feedback is not available for this account.
                </div>
            </div>
            <div t-if="request.env.user._int_help_hub_visible()" class="o_portal_category row g-2 mt-3" id="portal_help_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/int_helpdesk_customizations/static/src/img/help_feedback.svg'"/>
                    <t t-set="title">Help &amp; Feedback</t>
                    <t t-set="text">Returns, warranty, feedback, and part requests</t>
                    <t t-set="url" t-value="'/my/help'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="portal_help_breadcrumbs" name="Help &amp; Feedback breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'int_help'" class="breadcrumb-item">Help &amp; Feedback</li>
            <li t-if="page_name in ('int_help_form', 'int_help_done')" class="breadcrumb-item">
                <a href="/my/help">Help &amp; Feedback</a>
            </li>
            <li t-if="page_name == 'int_help_form'" class="breadcrumb-item" t-out="int_help_title"/>
            <li t-if="page_name == 'int_help_done'" class="breadcrumb-item">Request received</li>
        </xpath>
    </template>

    <template id="portal_help_hub" name="Help &amp; Feedback hub">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'int_help'"/>
            <t t-set="additional_title">Help &amp; Feedback</t>
            <h3 class="my-3">Help &amp; Feedback</h3>
            <div class="row g-2">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Start a return</t>
                    <t t-set="text">Return unused or incorrect items from an order. We'll review it and send return instructions.</t>
                    <t t-set="url" t-value="'/my/help/return'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Start a warranty claim</t>
                    <t t-set="text">Report a product that has failed. Include the serial number and photos so we can process it fast.</t>
                    <t t-set="url" t-value="'/my/help/warranty'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Website &amp; operations feedback</t>
                    <t t-set="text">Something broken, confusing or slow — on the site, in shipping, billing or anything else? Tell us and we'll fix it.</t>
                    <t t-set="url" t-value="'/my/help/feedback'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Request a part we don't stock</t>
                    <t t-set="text">Need something we don't carry? Tell us what it is and roughly how many you use per year.</t>
                    <t t-set="url" t-value="'/my/help/part'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_help_form" name="Help &amp; Feedback form">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'int_help_form'"/>
            <t t-set="additional_title" t-value="title"/>
            <t t-set="int_help_title" t-value="title"/>
            <t t-set="values" t-value="values or {}"/>
            <div class="o_int_help_card">
                <h3 class="mb-3" t-out="title"/>
                <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                <p t-if="notice" class="mb-0" t-out="notice"/>
                <form t-if="not notice" t-attf-action="/my/help/{{ kind }}" method="post" enctype="multipart/form-data" class="o_int_help_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <t t-if="kind in ('return', 'warranty')">
                        <div class="mb-3">
                            <label class="form-label" for="int_help_order">Order<t t-if="kind == 'return'"><span class="text-danger">*</span></t></label>
                            <select id="int_help_order" name="order_id" class="form-select js-int-help-order" t-att-required="kind == 'return' and 'required' or None">
                                <option value="">Select an order</option>
                                <t t-foreach="orders" t-as="order">
                                    <option t-att-value="order.id" t-att-selected="(values.get('order_id') or '') == str(order.id) and 'selected' or None" t-out="order.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_product">
                                <t t-if="kind == 'return'">Product / SKU<span class="text-danger">*</span></t>
                                <t t-else="">Product from this order</t>
                            </label>
                            <select id="int_help_product" name="product_id" class="form-select js-int-help-product" t-att-required="kind == 'return' and 'required' or None" t-att-data-selected="values.get('product_id') or ''">
                                <option value="">Select a product</option>
                            </select>
                        </div>
                    </t>

                    <div t-if="kind == 'warranty'" class="mb-3">
                        <label class="form-label" for="int_help_product_text">Product / SKU<span class="text-danger">*</span></label>
                        <input id="int_help_product_text" type="text" name="product_text" class="form-control" required="required" t-att-value="values.get('product_text') or ''"/>
                    </div>

                    <div t-if="kind in ('return', 'warranty')" class="mb-3">
                        <label class="form-label" for="int_help_serial">Serial number<t t-if="kind == 'warranty'"><span class="text-danger">*</span></t></label>
                        <input id="int_help_serial" type="text" name="serial" class="form-control" t-att-required="kind == 'warranty' and 'required' or None" t-att-value="values.get('serial') or ''"/>
                    </div>

                    <div t-if="kind == 'return'" class="mb-3">
                        <label class="form-label" for="int_help_quantity">Quantity<span class="text-danger">*</span></label>
                        <input id="int_help_quantity" type="number" name="quantity" class="form-control" required="required" min="0.01" step="any" t-att-value="values.get('quantity') or ''"/>
                    </div>

                    <div t-if="kind == 'return'" class="mb-3">
                        <label class="form-label" for="int_help_reason">Reason<span class="text-danger">*</span></label>
                        <select id="int_help_reason" name="reason" class="form-select" required="required">
                            <option value="">Select a reason</option>
                            <t t-foreach="reasons" t-as="reason">
                                <option t-att-value="reason[0]" t-att-selected="(values.get('reason') or '') == reason[0] and 'selected' or None" t-out="reason[1]"/>
                            </t>
                        </select>
                    </div>

                    <div t-if="kind == 'return'" class="mb-3">
                        <label class="form-label" for="int_help_details">Details</label>
                        <textarea id="int_help_details" name="details" class="form-control" rows="4"><t t-out="values.get('details') or ''"/></textarea>
                    </div>

                    <div t-if="kind == 'warranty'" class="mb-3">
                        <label class="form-label" for="int_help_install">Install date<span class="text-danger">*</span></label>
                        <input id="int_help_install" type="date" name="install_date" class="form-control" required="required" t-att-value="values.get('install_date') or ''"/>
                    </div>

                    <div t-if="kind == 'warranty'" class="mb-3">
                        <label class="form-label" for="int_help_failure">Description of failure<span class="text-danger">*</span></label>
                        <textarea id="int_help_failure" name="failure" class="form-control" rows="4" required="required"><t t-out="values.get('failure') or ''"/></textarea>
                    </div>

                    <t t-if="kind == 'feedback'">
                        <div class="mb-3">
                            <label class="form-label" for="int_help_area">Area<span class="text-danger">*</span></label>
                            <select id="int_help_area" name="area" class="form-select" required="required">
                                <option value="">Select an area</option>
                                <t t-foreach="areas" t-as="area">
                                    <option t-att-value="area[0]" t-att-selected="(values.get('area') or '') == area[0] and 'selected' or None" t-out="area[1]"/>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_description">Description<span class="text-danger">*</span></label>
                            <textarea id="int_help_description" name="description" class="form-control" rows="4" required="required"><t t-out="values.get('description') or ''"/></textarea>
                        </div>
                    </t>

                    <t t-if="kind == 'part'">
                        <div class="mb-3">
                            <label class="form-label" for="int_help_manufacturer">Manufacturer<span class="text-danger">*</span></label>
                            <input id="int_help_manufacturer" type="text" name="manufacturer" class="form-control" required="required" t-att-value="values.get('manufacturer') or ''"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_part">Part number or description<span class="text-danger">*</span></label>
                            <input id="int_help_part" type="text" name="part" class="form-control" required="required" t-att-value="values.get('part') or ''"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_qty_year">Estimated quantity per year</label>
                            <input id="int_help_qty_year" type="number" name="qty_per_year" class="form-control" min="0" step="any" t-att-value="values.get('qty_per_year') or ''"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="int_help_link">Link</label>
                            <input id="int_help_link" type="url" name="link" class="form-control" placeholder="https://" t-att-value="values.get('link') or ''"/>
                        </div>
                    </t>

                    <div t-if="max_files" class="mb-3">
                        <label class="form-label" for="int_help_files" t-out="upload_label"/>
                        <input id="int_help_files" type="file" name="attachments" class="form-control" t-att-accept="accept" multiple="multiple"/>
                        <div class="form-text">
                            Up to <t t-out="max_files"/> files, 20 MB each.
                            <t t-if="kind == 'warranty'">Images, MP4, or MOV.</t>
                            <t t-else="">JPG, PNG, GIF, or WebP.</t>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>
        </t>
    </template>

    <template id="portal_help_done" name="Help &amp; Feedback confirmation">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'int_help_done'"/>
            <t t-set="additional_title">Request received</t>
            <div class="o_int_help_card">
                <h3 class="mb-3">Request received</h3>
                <p>Your request number is <strong t-out="ticket_reference"/>.</p>
                <a t-attf-href="/helpdesk/ticket/{{ ticket_id }}" class="btn btn-primary">View your ticket</a>
            </div>
        </t>
    </template>
</odoo>

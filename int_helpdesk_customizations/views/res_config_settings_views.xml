<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.int.helpdesk</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Dealer Portal" name="int_helpdesk_dealer_portal" data-string="Dealer Portal">
                    <block title="Help &amp; Feedback" name="int_helpdesk_help_feedback">
                        <setting string="Team" help="Tickets from the dealer Help &amp; Feedback hub are created on this team. The hub stays hidden until a team is set.">
                            <field name="int_help_team_id" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Return tag" help="Applied to return requests.">
                            <field name="int_help_tag_return_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Warranty tag" help="Applied to warranty claims.">
                            <field name="int_help_tag_warranty_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Feedback tag" help="Applied to website and operations feedback.">
                            <field name="int_help_tag_feedback_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Part request tag" help="Applied to requests for a part we do not stock.">
                            <field name="int_help_tag_part_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_customizations" model="ir.ui.view">
        <field name="name">product.template.form.product.customizations</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">160</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='internal_notes']" position="after">
                <group name="studio_group_231_1jnv9maf4">
                    <group name="studio_group_231_left"/>
                    <group name="studio_group_231_right"/>
                </group>
                <notebook name="studio_notebook_4if_1jnv9ne6p">
                    <page string="Product Info" name="studio_page_4if">
                        <group name="studio_group_4if">
                            <group name="studio_group_4if_left">
                                <field name="x_studio_battery_compatibility" invisible="categ_id in [%(int_inventory_customizations.product_category_accessories_hardware)d]"/>
                                <field name="x_studio_certifications" widget="radio"/>
                                <field name="x_studio_voltage" string="Inverter Battery Voltage" invisible="categ_id not in [%(int_inventory_customizations.product_category_inverter_chargers)d]"/>
                                <field name="x_studio_ac_input_voltage" invisible="categ_id not in [%(int_inventory_customizations.product_category_inverter_chargers)d]"/>
                                <field name="x_studio_ac_voltage_inverting" invisible="categ_id not in [%(int_inventory_customizations.product_category_inverter_chargers)d]"/>
                                <field name="x_studio_ac_frequency" invisible="categ_id not in [%(int_inventory_customizations.product_category_inverter_chargers)d]"/>
                                <field name="x_studio_mppt_max_voltage" invisible="categ_id not in [%(int_inventory_customizations.product_category_solar_chargers)d]"/>
                                <field name="x_studio_max_charge_amps" invisible="categ_id not in [%(int_inventory_customizations.product_category_dc_dc_chargers)d, %(int_inventory_customizations.product_category_inverter_chargers)d, %(int_inventory_customizations.product_category_solar_chargers)d, %(int_inventory_customizations.product_category_batteries)d]"/>
                                <field name="x_studio_max_discharge_amps" invisible="categ_id not in [%(int_inventory_customizations.product_category_batteries)d]"/>
                                <field name="x_studio_max_continuous_watts" invisible="categ_id not in [%(int_inventory_customizations.product_category_inverter_chargers)d, %(int_inventory_customizations.product_category_dc_dc_chargers)d]"/>
                                <field name="x_studio_max_peak_watts" invisible="categ_id not in [%(int_inventory_customizations.product_category_dc_dc_chargers)d, %(int_inventory_customizations.product_category_inverter_chargers)d]"/>
                            </group>
                            <group name="studio_group_4if_right">
                                <field name="x_studio_approved_for_boats"/>
                                <field name="x_studio_approved_for_rvs"/>
                                <field name="x_studio_approved_for_off_grid"/>
                            </group>
                        </group>
                    </page>
                    <page string="Vendor Information" name="studio_page_68u_1jnv9ucav">
                        <group name="studio_group_68u">
                            <group name="studio_group_68u_left">
                                <field name="x_studio_hts_code"/>
                                <field name="x_studio_manufacturer"/>
                                <field name="x_studio_country_of_origin"/>
                            </group>
                            <group name="studio_group_68u_right">
                                <field name="x_studio_tariff_cost" help="If zero, included in cost"/>
                                <field name="x_studio_inbound_shipping_cost" help="If zero, included in cost"/>
                            </group>
                        </group>
                    </page>
                    <page string="Data Sheet" name="studio_page_6c4_1jpp3adom">
                        <group name="studio_group_1mo_1jpp3n231">
                            <group name="studio_group_1mo_left">
                                <field name="x_studio_product_data_sheet" filename="x_studio_product_data_sheet_filename" widget="pdf_viewer"/>
                            </group>
                            <group name="studio_group_1mo_right"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="x_studio_gtin"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Internal SKU</attribute>
            </xpath>
            <xpath expr="//div[@name='taxes_div']" position="after">
                <field name="x_studio_map_price"/>
            </xpath>
            <xpath expr="//group[@name='internal_notes']" position="attributes">
                <attribute name="string">Description</attribute>
            </xpath>
            <xpath expr="//group[@name='inventory']" position="after">
                <group name="studio_group_2mb_1jpov6kcd">
                    <group name="studio_group_2mb_left" string="Dimensions (mm)">
                        <field name="x_studio_length_mm"/>
                        <field name="x_studio_width_mm"/>
                        <field name="x_studio_height_mm"/>
                    </group>
                    <group name="studio_group_2mb_right" string="Dimensions (inches)">
                        <field name="x_studio_length_in"/>
                        <field name="x_studio_width_in"/>
                        <field name="x_studio_height_in"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='responsible_id']" position="after">
                <field name="x_studio_weight_lbs"/>
            </xpath>
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <field name="x_studio_qty_per_pallet"/>
            </xpath>
        </field>
    </record>
</odoo>

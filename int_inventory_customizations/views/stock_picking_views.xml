<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_split" model="ir.ui.view">
        <field name="name">stock.picking.form.int.split</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='do_print_picking']" position="before">
                <button name="action_int_split_delivery" type="object" string="Split"
                        groups="stock.group_stock_user"
                        invisible="picking_type_code != 'outgoing' or state in ('draft', 'done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>

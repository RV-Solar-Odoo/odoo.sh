<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_data_sheet" model="ir.ui.view">
        <field name="name">product.template.form.data.sheet</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Website Data Sheet" name="rvs_data_sheet">
                    <field name="product_data_sheet" filename="product_data_sheet_filename"/>
                    <field name="product_data_sheet_filename" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

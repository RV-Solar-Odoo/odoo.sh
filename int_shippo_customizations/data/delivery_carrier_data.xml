<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_product_delivery_shippo" model="product.product">
        <field name="name">Shippo Shipping</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>
    <record id="delivery_carrier_shippo" model="delivery.carrier">
        <field name="name">Shippo</field>
        <field name="delivery_type">shippo</field>
        <field name="integration_level">rate</field>
        <field name="product_id" ref="product_product_delivery_shippo"/>
    </record>
    <record id="delivery_carrier_shippo_ups" model="delivery.carrier">
        <field name="name">UPS</field>
        <field name="delivery_type">shippo</field>
        <field name="integration_level">rate</field>
        <field name="int_shippo_provider">UPS</field>
        <field name="product_id" ref="product_product_delivery_shippo"/>
        <field name="is_published" eval="False"/>
    </record>
    <record id="delivery_carrier_shippo_usps" model="delivery.carrier">
        <field name="name">USPS</field>
        <field name="delivery_type">shippo</field>
        <field name="integration_level">rate</field>
        <field name="int_shippo_provider">USPS</field>
        <field name="product_id" ref="product_product_delivery_shippo"/>
        <field name="is_published" eval="False"/>
    </record>
    <record id="delivery_carrier_shippo_fedex" model="delivery.carrier">
        <field name="name">FedEx</field>
        <field name="delivery_type">shippo</field>
        <field name="integration_level">rate</field>
        <field name="int_shippo_provider">FedEx</field>
        <field name="product_id" ref="product_product_delivery_shippo"/>
        <field name="is_published" eval="False"/>
    </record>
    <record id="delivery_carrier_shippo_ups_ground" model="delivery.carrier">
        <field name="name">UPS Ground</field>
        <field name="delivery_type">shippo</field>
        <field name="integration_level">rate</field>
        <field name="int_shippo_provider">UPS</field>
        <field name="int_shippo_service_include">ground</field>
        <field name="int_shippo_service_exclude">saver,surepost</field>
        <field name="int_free_over_amount">250</field>
        <field name="product_id" ref="product_product_delivery_shippo"/>
        <field name="sequence">21</field>
        <field name="is_published" eval="True"/>
    </record>
    <record id="delivery_carrier_shippo_ups_ground_saver" model="delivery.carrier">
        <field name="name">UPS Ground Saver</field>
        <field name="delivery_type">shippo</field>
        <field name="integration_level">rate</field>
        <field name="int_shippo_provider">UPS</field>
        <field name="int_shippo_service_include">ground saver,surepost</field>
        <field name="product_id" ref="product_product_delivery_shippo"/>
        <field name="sequence">22</field>
        <field name="is_published" eval="False"/>
    </record>
    <record id="delivery_carrier_shippo_ups_2day" model="delivery.carrier">
        <field name="name">UPS 2 Day</field>
        <field name="delivery_type">shippo</field>
        <field name="integration_level">rate</field>
        <field name="int_shippo_provider">UPS</field>
        <field name="int_shippo_service_include">2nd day,2 day,second day</field>
        <field name="product_id" ref="product_product_delivery_shippo"/>
        <field name="sequence">23</field>
        <field name="is_published" eval="True"/>
    </record>
    <record id="delivery_carrier_shippo_ups_overnight" model="delivery.carrier">
        <field name="name">UPS Overnight</field>
        <field name="delivery_type">shippo</field>
        <field name="integration_level">rate</field>
        <field name="int_shippo_provider">UPS</field>
        <field name="int_shippo_service_include">next day,overnight</field>
        <field name="product_id" ref="product_product_delivery_shippo"/>
        <field name="sequence">24</field>
        <field name="is_published" eval="True"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">delivery.carrier.form.int.shippo</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_type']" position="after">
                <div invisible="delivery_type != 'shippo'" colspan="2">
                    <p>Rates and labels come from Inventory → Settings → Shippo. On a delivery, use Get Shippo Rates, pick a box, then buy the label.</p>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

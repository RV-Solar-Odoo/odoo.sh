<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.int.shippo</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_shippo_rates" type="object" string="Get Shippo Rates"
                        class="btn-primary"
                        invisible="picking_type_code != 'outgoing' or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Shippo" name="int_shippo" invisible="picking_type_code != 'outgoing'">
                    <group>
                        <field name="int_shippo_package_type_id"/>
                        <field name="int_shippo_label_url" widget="url" invisible="not int_shippo_label_url"/>
                        <field name="int_shippo_tracking_url" widget="url" invisible="not int_shippo_tracking_url"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

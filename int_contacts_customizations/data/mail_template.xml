<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_dealer_sign_in" model="mail.template">
            <field name="name">Dealer: sign in to your existing account</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Your dealer account is ready</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ object.email_formatted }}</field>
            <field name="description">Sent when a dealer is approved and they already created an account, for example at checkout.</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Hi <t t-out="object.name or ''">Alex</t>,</p>
    <p>Your dealer account is ready. You already have a login, so you do not need a new password.</p>
    <p>Sign in with <strong t-out="object.email or object.login or ''">alex@example.com</strong>.</p>
    <p>
        <a t-attf-href="{{ object.get_base_url() }}/web/login">Sign in</a>
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>

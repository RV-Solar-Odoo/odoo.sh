<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_dealer_account_email" model="ir.ui.view">
        <field name="name">res.partner.form.dealer.account.email</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_int_send_dealer_account_email" type="object"
                            string="Send account setup email"
                            class="btn-primary"
                            groups="sales_team.group_sale_salesman"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_portal_role" model="ir.ui.view">
        <field name="name">res.partner.form.portal.role</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']/field[@name='user_id']" position="after">
                <field name="int_portal_role"/>
                <field name="int_address_category"/>
                <field name="int_location_type"/>
                <field name="int_has_loading_dock" invisible="int_location_type != 'commercial'"/>
                <field name="int_has_forklift" invisible="int_location_type != 'commercial'"/>
            </xpath>
        </field>
    </record>
</odoo>

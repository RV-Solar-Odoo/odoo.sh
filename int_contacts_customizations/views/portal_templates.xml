<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Used on My Portal and on Help & Feedback. Hidden when no salesperson is set. -->
    <template id="portal_sales_rep_card" name="Sales rep card">
        <t t-set="int_sales_rep" t-value="request.env.user._int_portal_sales_rep()"/>
        <div t-if="int_sales_rep" class="o_int_summary_card o_int_rep_card">
            <h3>Your Sales Rep</h3>
            <div class="o_int_rep_body">
                <img t-if="int_sales_rep['image']" class="o_int_rep_photo" t-att-src="int_sales_rep['image']" t-att-alt="int_sales_rep['name']"/>
                <div>
                    <div class="o_int_rep_name" t-out="int_sales_rep['name']"/>
                    <a t-if="int_sales_rep['email']" class="o_int_rep_link" t-attf-href="mailto:{{ int_sales_rep['email'] }}" t-out="int_sales_rep['email']"/>
                    <a t-if="int_sales_rep['phone_href']" class="o_int_rep_link" t-att-href="int_sales_rep['phone_href']" t-out="int_sales_rep['phone']"/>
                </div>
            </div>
        </div>
    </template>

    <template id="portal_my_home_sales_rep" name="My Portal sales rep" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div class="o_int_portal_summary" id="int_portal_summary">
                <t t-call="int_contacts_customizations.portal_sales_rep_card"/>
            </div>
        </xpath>
    </template>

    <template id="portal_my_home_users" name="My Portal users" inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-if="request.env.user.int_portal_can('manage_users')" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                <t t-set="title">Users</t>
                <t t-set="text">Invite people and choose what they can see</t>
                <t t-set="url" t-value="'/my/users'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_users_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'int_users'" class="breadcrumb-item">Users</li>
        </xpath>
    </template>

    <template id="portal_users" name="Portal users">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Users</t>
            <h3>Users</h3>
            <p class="text-muted">People who sign in for this dealer. The role controls invoices, payments, credit, and ordering.</p>
            <div t-if="int_error" class="alert alert-warning" role="alert" t-out="int_error"/>
            <form action="/my/users/invite" method="post" class="row g-2 mb-4">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="col-md-4">
                    <input class="form-control" name="name" placeholder="Name" required="required"/>
                </div>
                <div class="col-md-4">
                    <input class="form-control" type="email" name="email" placeholder="Email" required="required"/>
                </div>
                <div class="col-md-2">
                    <select class="form-select" name="role">
                        <option value="owner">Owner</option>
                        <option value="buyer" selected="selected">Buyer</option>
                        <option value="accountant">Accountant</option>
                        <option value="viewer">Viewer</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit">Invite</button>
                </div>
            </form>
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Last login</th>
                        <th>Status</th>
                        <th/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="int_users" t-as="portal_user">
                        <td t-out="portal_user.name"/>
                        <td t-out="portal_user.login"/>
                        <td>
                            <form t-attf-action="/my/users/{{ portal_user.id }}/role" method="post" class="d-flex gap-2">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <select class="form-select" name="role">
                                    <t t-foreach="int_roles" t-as="role">
                                        <option t-att-value="role[0]" t-att-selected="(portal_user.partner_id.int_portal_role or 'owner') == role[0]" t-out="role[1]"/>
                                    </t>
                                </select>
                                <button class="btn btn-secondary" type="submit">Save</button>
                            </form>
                        </td>
                        <td>
                            <span t-if="portal_user.login_date" t-field="portal_user.login_date"/>
                        </td>
                        <td>
                            <span t-if="not portal_user.active">Disabled</span>
                            <span t-elif="not portal_user.login_date">Invited</span>
                            <span t-else="">Active</span>
                        </td>
                        <td class="text-end">
                            <form t-attf-action="/my/users/{{ portal_user.id }}/resend" method="post" class="d-inline">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button class="btn btn-link" type="submit">Resend invite</button>
                            </form>
                            <form t-attf-action="/my/users/{{ portal_user.id }}/active" method="post" class="d-inline">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="active" t-att-value="'0' if portal_user.active else '1'"/>
                                <button class="btn btn-link" type="submit">
                                    <t t-if="portal_user.active">Disable</t>
                                    <t t-else="">Enable</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

    <template id="portal_address_fields" inherit_id="portal.address_form_fields">
        <xpath expr="//label[@for='o_name']" position="replace">
            <label class="col-form-label" for="o_name">Name</label>
        </xpath>
        <xpath expr="//small[contains(., 'your main account')]" position="replace">
            <small class="form-text text-muted">
                The company name and VAT number can only be updated on the main account.
                <t t-if="commercial_address_update_url">
                    If you want to modify it, update
                    <a t-att-href="commercial_address_update_url">the account details</a>.
                </t>
            </small>
        </xpath>
        <xpath expr="//div[@id='div_street']" position="before">
            <div class="col-lg-12 mb-2">
                <label class="col-form-label">This address is</label>
                <select class="form-select" name="int_address_category">
                    <option value="business" t-att-selected="partner_sudo.int_address_category != 'customer'">My business location</option>
                    <option value="customer" t-att-selected="partner_sudo.int_address_category == 'customer' or (not partner_sudo and request.params.get('int_address_category') == 'customer')">A customer (drop-ship)</option>
                </select>
            </div>
            <div class="col-lg-12 mb-2">
                <label class="col-form-label">Location</label>
                <select class="form-select" name="int_location_type">
                    <option value="">Select</option>
                    <option value="commercial" t-att-selected="partner_sudo.int_location_type == 'commercial'">Commercial</option>
                    <option value="residential" t-att-selected="partner_sudo.int_location_type == 'residential'">Residential</option>
                </select>
            </div>
            <div class="col-lg-6 mb-2">
                <label class="col-form-label">Loading dock</label>
                <select class="form-select" name="int_has_loading_dock">
                    <option value="0" t-att-selected="not partner_sudo.int_has_loading_dock">No</option>
                    <option value="1" t-att-selected="partner_sudo.int_has_loading_dock">Yes</option>
                </select>
            </div>
            <div class="col-lg-6 mb-2">
                <label class="col-form-label">Forklift on site</label>
                <select class="form-select" name="int_has_forklift">
                    <option value="0" t-att-selected="not partner_sudo.int_has_forklift">No</option>
                    <option value="1" t-att-selected="partner_sudo.int_has_forklift">Yes</option>
                </select>
            </div>
        </xpath>
    </template>

    <!-- My addresses as three tabs: business locations, customer (drop-ship)
         addresses, and billing. Stock ids and classes the address script needs
         stay: #use_delivery_as_billing, #billing_container,
         .o_add_billing_address_btn, .o_address_card_add_new, .o_remove_address. -->
    <template id="portal_my_addresses_tabs" name="My addresses tabs" inherit_id="portal.my_addresses">
        <xpath expr="//section[hasclass('o_portal_addresses')]" position="replace">
            <t t-set="int_tab" t-value="int_address_tab or 'business'"/>
            <t t-set="int_can_manage" t-value="request.env.user.int_portal_can('manage_addresses')"/>
            <section class="o_portal_addresses o_int_addresses">
                <div class="o_int_addr_head">
                    <h3>Addresses</h3>
                    <div t-if="int_can_manage" class="o_int_addr_export">
                        Export
                        <a href="/my/addresses/export?export_format=xlsx">XLSX</a>
                        <a href="/my/addresses/export?export_format=csv">CSV</a>
                    </div>
                </div>
                <ul class="nav o_int_addr_tabs" role="tablist">
                    <t t-foreach="[('business', 'My Business Locations', business_count), ('billing', 'My Billing Addresses', billing_count), ('customer', 'Customer Addresses', customer_count)]" t-as="int_tab_info">
                        <li class="nav-item" role="presentation">
                            <button type="button" role="tab" data-bs-toggle="tab"
                                    t-att-data-int-tab="int_tab_info[0]"
                                    t-attf-id="int_addr_tab_{{ int_tab_info[0] }}"
                                    t-attf-data-bs-target="#int_addr_pane_{{ int_tab_info[0] }}"
                                    t-attf-aria-controls="int_addr_pane_{{ int_tab_info[0] }}"
                                    t-att-aria-selected="'true' if int_tab == int_tab_info[0] else 'false'"
                                    t-attf-class="nav-link #{'active' if int_tab == int_tab_info[0] else ''}">
                                <t t-out="int_tab_info[1]"/>
                                <span class="o_int_addr_count" t-out="int_tab_info[2]"/>
                            </button>
                        </li>
                    </t>
                </ul>
                <div class="tab-content">
                    <t t-call="int_contacts_customizations.portal_address_pane">
                        <t t-set="pane" t-value="'business'"/>
                        <t t-set="pane_addresses" t-value="business_addresses"/>
                        <t t-set="pane_search_name" t-value="'business_search'"/>
                        <t t-set="pane_search" t-value="business_search"/>
                        <t t-set="pane_placeholder">Search business locations</t>
                        <t t-set="pane_hint">Your shop, warehouse, and other places that receive orders.</t>
                        <t t-set="pane_empty">No business locations yet.</t>
                    </t>
                    <div id="int_addr_pane_billing" role="tabpanel" aria-labelledby="int_addr_tab_billing"
                         t-attf-class="tab-pane fade #{'show active' if int_tab == 'billing' else ''}">
                        <t t-set="address_type" t-valuef="billing"/>
                        <t t-set="new_address_url" t-value="address_url + '?address_type=billing&amp;callback=/my/addresses?tab=billing'"/>
                        <div class="o_int_addr_toolbar">
                            <div class="form-check form-switch mb-0">
                                <label id="use_delivery_as_billing_label">
                                    <input type="checkbox" id="use_delivery_as_billing" class="form-check-input"
                                           t-att-checked="use_delivery_as_billing"/>
                                    Bill to my delivery address
                                </label>
                            </div>
                            <a t-if="int_can_manage" role="button" t-att-href="new_address_url"
                               data-address-type="billing"
                               t-attf-class="o_address_card_add_new o_add_billing_address_btn btn btn-primary btn-sm {{'d-none' if use_delivery_as_billing else ''}}"
                               title="Add a billing address" aria-label="Add a billing address">
                                <i class="oi oi-plus me-2"/>Add Address
                            </a>
                        </div>
                        <p class="o_int_addr_hint">Where invoices are sent.</p>
                        <div id="billing_container" t-attf-class="{{'d-none' if use_delivery_as_billing else ''}}">
                            <t t-call="portal.address_list">
                                <t t-set="addresses" t-value="billing_addresses"/>
                            </t>
                        </div>
                    </div>
                    <t t-call="int_contacts_customizations.portal_address_pane">
                        <t t-set="pane" t-value="'customer'"/>
                        <t t-set="pane_addresses" t-value="customer_addresses"/>
                        <t t-set="pane_search_name" t-value="'customer_search'"/>
                        <t t-set="pane_search" t-value="customer_search"/>
                        <t t-set="pane_placeholder">Search customer addresses</t>
                        <t t-set="pane_hint">Your customers' addresses, for orders shipped straight to them.</t>
                        <t t-set="pane_empty">No customer addresses yet.</t>
                    </t>
                </div>
                <p t-if="int_addresses_truncated" class="o_int_addr_more">
                    <a t-attf-href="/my/addresses?show=all&amp;tab={{ int_tab }}&amp;business_search={{ business_search }}&amp;customer_search={{ customer_search }}">Show all addresses</a>
                </p>
            </section>
        </xpath>
    </template>

    <template id="portal_address_pane" name="My addresses tab">
        <t t-set="address_type" t-valuef="delivery"/>
        <t t-set="new_address_url" t-value="address_url + '?address_type=delivery&amp;use_delivery_as_billing=' + str(use_delivery_as_billing) + ('&amp;int_address_category=customer' if pane == 'customer' else '') + '&amp;callback=/my/addresses?tab=' + pane"/>
        <div t-attf-id="int_addr_pane_{{ pane }}" role="tabpanel" t-attf-aria-labelledby="int_addr_tab_{{ pane }}"
             t-attf-class="tab-pane fade #{'show active' if int_tab == pane else ''}">
            <div class="o_int_addr_toolbar">
                <form method="get" action="/my/addresses" class="o_int_addr_search" role="search">
                    <input type="hidden" name="tab" t-att-value="pane"/>
                    <input t-if="pane == 'customer'" type="hidden" name="business_search" t-att-value="business_search"/>
                    <input t-if="pane == 'business'" type="hidden" name="customer_search" t-att-value="customer_search"/>
                    <i class="fa fa-search" aria-hidden="true"/>
                    <input class="form-control" type="search" t-att-name="pane_search_name" t-att-value="pane_search"
                           t-att-placeholder="pane_placeholder" t-att-aria-label="pane_placeholder"/>
                </form>
                <a t-if="int_can_manage" role="button" t-att-href="new_address_url"
                   data-address-type="delivery"
                   class="o_address_card_add_new btn btn-primary btn-sm"
                   title="Add an address" aria-label="Add an address">
                    <i class="oi oi-plus me-2"/>Add Address
                </a>
            </div>
            <p class="o_int_addr_hint" t-out="pane_hint"/>
            <t t-if="pane_addresses" t-call="portal.address_list">
                <t t-set="addresses" t-value="pane_addresses"/>
            </t>
            <div t-else="" class="o_int_addr_empty">
                <t t-if="pane_search">No addresses match "<t t-out="pane_search"/>".</t>
                <t t-else="" t-out="pane_empty"/>
            </div>
        </div>
    </template>

    <!-- Address card: tags and the move link go under the address, in the card
         body; the stylesheet puts the badge and edit buttons in a right column.
         Also used at checkout (website_sale.address_card is built on this one). -->
    <template id="portal_address_card_category" inherit_id="portal.address_card">
        <xpath expr="//div[hasclass('card-body')]/t[@t-out='contact']" position="after">
            <div class="o_int_addr_tags" t-if="contact">
                <span t-if="contact.int_address_category == 'customer'">Customer</span>
                <span t-else="">Business</span>
                <span t-if="contact.int_location_type == 'commercial'">Commercial</span>
                <span t-if="contact.int_location_type == 'residential'">Residential</span>
                <span t-if="contact.int_has_loading_dock">Loading dock</span>
                <span t-if="contact.int_has_forklift">Forklift</span>
            </div>
            <form t-if="page_name == 'my_addresses' and contact and address_type == 'delivery' and contact.int_address_category != 'customer' and request.env.user.int_portal_can('manage_addresses') and contact != contact.commercial_partner_id"
                  action="/my/address/category" method="post" class="o_int_addr_move">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="partner_id" t-att-value="contact.id"/>
                <input type="hidden" name="category" value="customer"/>
                <button class="btn btn-link p-0" type="submit">
                    Move to customer addresses
                    <i class="fa fa-long-arrow-right ms-1" aria-hidden="true"/>
                </button>
            </form>
        </xpath>
        <xpath expr="//div[hasclass('card-body')]" position="attributes">
            <attribute name="class" add="o_int_addr_body" separator=" "/>
        </xpath>
    </template>
</odoo>

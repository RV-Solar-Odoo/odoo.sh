<?xml version="1.0"?>
<templates>
    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
      <xpath expr="//a[hasclass('o_form_uri')]" position="attributes">
        <attribute name="t-on-click">onLinkClicked</attribute>
      </xpath>
      <xpath expr="//a[hasclass('o_phone_form_link')]" position="attributes">
        <attribute name="t-on-click">onLinkClicked</attribute>
      </xpath>
    </t>
    <t t-inherit="sms.SendSMSButton" t-inherit-mode="extension">
         <xpath expr="//a[hasclass('o_field_phone_sms')]" position="attributes">
              <attribute name="t-on-click.prevent.stop">onZoomSMSClicked</attribute>
         </xpath>
    </t>
</templates>
